							}
							
							break;
						
						case 'get_shipping_calendar':
							
							if( preg_match('/[0-9]{4}\-[0-9]{2}\-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}/', $result) || strpos($result, '"Ошибка":') !== false || strpos($result, '[]') !== false){
								$json = json_decode($result, true);
							}
							
							break;
						
						case 'get_pickup_intervals':
							
							if(strpos($result, '"ИнтервалИД":') !== false || strpos($result, '"Ошибка":') !== false || strpos($result, '[]') !== false){
								$json = json_decode($result, true);
							}
							
							break;
						
						case 'get_delivery_intervals':
							
							if(strpos($result, '"ИнтервалИД":') !== false || strpos($result, '"Ошибка":') !== false || strpos($result, '[]') !== false){
								$json = json_decode($result, true);
							}
							
							break;
						
						case 'get_orders_for_shipment':
							
							if(strpos($result, '"ЗаказПокупателяИД":') !== false || strpos($result, '"Ошибка":') !== false || strpos($result, '[]') !== false){
								$json = json_decode($result, true);
							}
							
							break;
						
						case 'shipment_creation':
							
							if(strpos($result, '"ЗаявкаНаОтгрузкуИД":') !== false || strpos($result, '"Ошибка":') !== false){
								$json = json_decode($result, true);
							}
							
							break;
						
						case 'get_shipment_details':
							
							if(strpos($result, '"ЗаявкаНаОтгрузкуИД":') !== false || strpos($result, '"Ошибка":') !== false){
								$json = json_decode($result, true);
							}
							
							break;
						
						case 'get_order_details':
							
							if(strpos($result, '"ЗаказПокупателяИД":') !== false || strpos($result, '"Ошибка":') !== false){
								$json = json_decode($result, true);
							}
							
							break;
						
						case 'download_order_details':
							
							if(strpos($result, '"Данные":') !== false || strpos($result, '"Ошибка":') !== false){
								$json = json_decode($result, true);
							}
							
							break;
						
						case 'get_invoices':
							
							if(strpos($result, '"РасходнаяНакладнаяИД":') !== false || strpos($result, '"Ошибка":') !== false || strpos($result, '[]') !== false){
								$json = json_decode($result, true);
							}
							
							break;
						
						case 'download_invoice':
							
							if(strpos($result, '"Данные":') !== false || strpos($result, '"Ошибка":') !== false ){
								$json = json_decode($result, true);
							}
							
							break;
						
						case 'download_mutual_settlements':
							
							if(strpos($result, '"Данные":') !== false || strpos($result, '"Ошибка":') !== false){
								$json = json_decode($result, true);
							}
							
							break;
							
					}
					
					if($json != ''){
						
						$result = $json;
						
					}else{
						
						$err = substr(htmlspecialchars($result, ENT_QUOTES, $this->encoding), 0, 255);
						$err = preg_replace('/\r?\n/', '', $err);
						
						if($err == ''){
							if($end_time - $start_time >= $this->config_project['connect_process_timeout2']){
								$err = 'CONNECTION_TIMEOUT ('.$full_url.')';
							}else{
								$err = 'RESULT_IS_EMPTY ('.$full_url.')';
							}
							$this->log_er_post_request_to_api_1c($err);
							continue;
						}
						$this->log_er_post_request_to_api_1c($err);
						
					}
					
				}else{
					$err = 'FAIL_SOCKET_CONNECT ('.$full_url.')';
					$this->log_er_post_request_to_api_1c($err);
					continue;
				}
				
				curl_close($cl);
				unset($cl);
				
				break;
				
			}
		
		}else{
			$err = 'FAIL_CURL_INIT';
			$this->log_er_post_request_to_api_1c($err);
		}
		
		return [$result, $err];
			
	}
	
	protected function control_fail_auth_and_set_ban() : void {
		
		$ip_hash = md5($this->ip.'ip_hash');
		
		$result = DB::select('SELECT `timestamp_fail_auth`, `count_fail_auth` FROM `ban_list` WHERE `ip_hash` = :ip_hash LIMIT 1', ['ip_hash' => $ip_hash]);
		
		if(sizeof($result) == 0){
			DB::insert('INSERT INTO `ban_list` (`ip_hash`, `count_fail_auth`, `timestamp_fail_auth`) values (:ip_hash, :count_fail_auth, :timestamp_fail_auth)', ['ip_hash' => $ip_hash, 'count_fail_auth' => 1, 'timestamp_fail_auth' => $this->time]);
			return;
		}
		
		foreach ($result as $row) {
			
			if($this->time - $row->timestamp_fail_auth <= $this->config_project['find_time_fail_auth']){
				
				$count_fail_auth = $row->count_fail_auth;
				$count_fail_auth++;
				DB::update('UPDATE `ban_list` SET `count_fail_auth` = :count_fail_auth WHERE `ip_hash` = :ip_hash LIMIT 1', ['count_fail_auth' => $count_fail_auth, 'ip_hash' => $ip_hash]);
				if($count_fail_auth >= $this->config_project['max_count_fail_auth']){
					DB::update('UPDATE `ban_list` SET `count_fail_auth` = 0, `timestamp_fail_auth` = 0, `timestamp_set_ban` = :timestamp_set_ban WHERE `ip_hash` = :ip_hash LIMIT 1', ['timestamp_set_ban' => $this->time, 'ip_hash' => $ip_hash]);
					$this->prepare_response(['error'=>'BANNED', 'seconds_left' => $this->config_project['time_ban_if_fail_auth']]);
				}
				
			}else{
				
				DB::update('UPDATE `ban_list` SET `count_fail_auth` = 1, `timestamp_fail_auth` = :timestamp_fail_auth, `timestamp_set_ban` = 0 WHERE `ip_hash` = :ip_hash LIMIT 1', ['timestamp_fail_auth' => $this->time, 'ip_hash' => $ip_hash]);
				
			}
			
		}
		
	}
	
	protected function check_is_auth() : bool {
		
		$user_myid = preg_replace('/[^a-f0-9\-]/', '', $_COOKIE['user_myid'] ?? '');
		$token = preg_replace('/[^a-f0-9\-]/', '', $_COOKIE['token'] ?? '');
		$token_hash = md5($token . 'token_hash');
		$is_auth = false;
		
		if($this->check_valid_cookies() != ''){
			return $is_auth;
		}
		
		if($user_myid != ''){
			
			try{
				
				$result = DB::select('SELECT `id` FROM `users` WHERE (`user_myid` = :user_myid) AND (`token_hash` = :token_hash) AND (:time - `expires_token` < 0) LIMIT 1', ['user_myid' => $user_myid, 'token_hash' => $token_hash, 'time' => $this->time]);
				if(sizeof($result) > 0){
					$is_auth = true;
				}
				
			} catch (QueryException $e) {
				$this->log_er_mysql(mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8'));
			}
			
		}
		
		return $is_auth;
		
	}
	
	protected function check_valid_cookies() : string {
		
		$user_myid = preg_replace('/[^a-f0-9\-]/', '', $_COOKIE['user_myid'] ?? '');
		$uid = preg_replace('/[^a-f0-9 ]/', '', $_COOKIE['uid'] ?? '');

		if(md5($user_myid . $this->config_project['auth_salt']) != $uid){
			return 'FAIL_USER_MYID';
		}
		
		return '';
		
	}
	
	protected function get_other_user_data() : array {
		
		$user_myid = preg_replace('/[^a-f0-9\-]/', '', $_COOKIE['user_myid'] ?? '');
		$phone = '';
		$email = '';
		$status = '';
		$fio = '';
		$photo = '';
		$manager_fio = '';
		$manager_email = '';
		$manager_id = '';
		$is_not_enter_verify_code = false;
		$client_user_myid = '';
		$delegation_fio = '';
		$delegation_user_myid = '';
		$csrf_token = csrf_token();
		$server_rsa_pubkey = '';
		
		list($rsa_pubkey, $rsa_privkey, $err) = $this->get_common_rsa_keys();
		if($rsa_pubkey){
			$server_rsa_pubkey = $rsa_pubkey;
		}
		
		if($user_myid != ''){
				
			try{
				
				$result = DB::select('SELECT CONVERT(AES_DECRYPT(`phone`, :aes_key) USING utf8mb4) AS `phone`, `user_myid`, CONVERT(AES_DECRYPT(`email`, :aes_key2) USING utf8mb4) AS `email`, `status`, CONVERT(AES_DECRYPT(`fio`, :aes_key3) USING utf8mb4) AS `fio`, `photo`, CONVERT(AES_DECRYPT(`manager_fio`, :aes_key4) USING utf8mb4) AS `manager_fio`, CONVERT(AES_DECRYPT(`manager_email`, :aes_key5) USING utf8mb4) AS `manager_email`, `manager_id`, `verify_code_email`, `client_user_myid` FROM `users` WHERE `user_myid` = :user_myid LIMIT 1', ['aes_key' => $this->aes_key[0], 'aes_key2' => $this->aes_key[0], 'aes_key3' => $this->aes_key[0], 'aes_key4' => $this->aes_key[0], 'aes_key5' => $this->aes_key[0], 'user_myid' => $user_myid]);
				
				foreach ($result as $row) {
					
					$phone = '+7'.$row->phone;
					$email = $row->email;
					$status = $row->status;
					$fio = $row->fio;
					$photo = $row->photo;
					if($row->photo != ''){
						$photo = '/user_files/'.$user_myid.'/photo/'.$row->photo;
					}
					$manager_fio = $row->manager_fio;
					$manager_email = $row->manager_email;
					$manager_id = $row->manager_id;
					$is_not_enter_verify_code = ($row->verify_code_email != '');
					$client_user_myid = $row->client_user_myid;
					
				}
							
			} catch (QueryException $e) {	
				$this->log_er_mysql(mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8'));
			}
			
			if($status == 'Сотрудник'){
				
				try{
					
					$result = DB::select('SELECT `delegation_user_myid` FROM `employees_'.$client_user_myid.'` WHERE `user_myid` = :user_myid LIMIT 1', ['user_myid' => $user_myid]);
					foreach ($result as $row) {
						$delegation_user_myid = $row->delegation_user_myid;
					}
					if($delegation_user_myid != ''){
						$result = DB::select('SELECT CONVERT(AES_DECRYPT(`fio`, :aes_key) USING utf8mb4) AS `fio` FROM `users` WHERE `user_myid` = :delegation_user_myid LIMIT 1', ['aes_key' => $this->aes_key[0], 'delegation_user_myid' => $delegation_user_myid]);
						foreach ($result as $row) {
							if($row->fio != ''){
								preg_match('/([^ ]+) ([^ ]+) ([^ ]+)/', $row->fio, $matches);
								if($matches){
									$delegation_fio = mb_strtoupper(mb_substr($matches[1], 0, 1)) . mb_strtolower(mb_substr($matches[1], 1, 255)) . ' ' . mb_strtoupper(mb_substr($matches[2], 0, 1)) . '.' . mb_strtoupper(mb_substr($matches[3], 0, 1)) . '.';
								}
							}
						}
					}
					
				} catch (QueryException $e) {	
					$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
					if(strpos($err, 'Base table or view not found') === false){
						$this->log_er_mysql($err);
					}
				}
				
			}
			
		}
		
		return [$phone, $user_myid, $email, $status, $fio, $photo, $manager_fio, $manager_email, $manager_id, $is_not_enter_verify_code, $delegation_fio, $delegation_user_myid, $csrf_token, $server_rsa_pubkey];
		
	}
	
	protected function create_guid() : string {
		
		$uuid = '';

		if (function_exists('com_create_guid')){
			$uuid = trim(com_create_guid(), '{}');
		}else{
			$uuid = sprintf('%04X%04X-%04X-%04X-%04X-%04X%04X%04X', mt_rand(0, 65535), mt_rand(0, 65535), mt_rand(0, 65535), mt_rand(16384, 20479), mt_rand(32768, 49151), mt_rand(0, 65535), mt_rand(0, 65535), mt_rand(0, 65535));
		}

		return strtolower($uuid);

	}
	
	protected function get_news(int $page, int $limit) : array {
		
		$user_myid = preg_replace('/[^a-f0-9\-]/', '', $_COOKIE['user_myid'] ?? '');
		
		$arr_news = [];
		$user_id = '';
		$pagination_max_page = 1;
		
		try{
			
			$result = DB::select('SELECT `id` FROM `users` WHERE `user_myid` = :user_myid LIMIT 1', ['user_myid' => $user_myid]);
			
			foreach ($result as $row) {
				$user_id = (string) $row->id;
			}
			
			$count = DB::table('news')->count('id');
			$max_id = DB::table('news')->max('id');
			$max_id++;
			$pagination_max_page = ceil($count / $limit);
			$pagination_max_page = ($pagination_max_page < 1 ? 1 : $pagination_max_page);
			
			if($page == 1){
				$result = DB::select('SELECT * FROM `news` ORDER BY `id` DESC LIMIT :limit', ['limit' => $limit]);
			}else{
				$result = DB::select('SELECT * FROM `news` WHERE `id` < :last_id ORDER BY `id` DESC LIMIT :limit', ['last_id' => ($max_id - ($limit * ($page - 1))), 'limit' => $limit]); 
			}
			
			foreach ($result as $row) {
				$is_unread = (strpos($row->user_ids_is_read, $user_id.' ') === false ? '1' : '');
				$arr_news[] = ['id' => $row->id, 'date' => $row->date, 'header' => $row->header, 'text' => $row->text, 'is_unread' => $is_unread];
			}
			
		} catch (QueryException $e) {
			$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
			$this->log_er_mysql($err);
			return ['error'=>$err];
		}
		
		return array('data' => $arr_news, 'pagination_max_page' => $pagination_max_page);
		
	}
	
	protected function get_orders(string $main_counterparty_id, int $page, int $limit, string $order_date1 = '', string $order_date2 = '',  string $statuses = 'in_processing,needs_confirmation,in_work,ready_for_shipment,shipped,in_shipment,canceled', string $responsible_id = '', string $counterparty_id = '', string $payment = '', string $shipping_warehouse_id = '', string $responsible_sokrof_id = '', string $sort = 'order_date_new_first') : array {
		
		$arr_orders = [];
		$pagination_max_page = 1;
		$result = [];
		$result2 = [];
		$id = 0;
		
		if($page < 1){$page = 1;}
		
		if($order_date1 != ''){
			$timestamp_order1 = date('U', strtotime($order_date1));
			$timestamp_order2 = date('U', strtotime($order_date2)) + 60;
			if($timestamp_order1 < 0){$timestamp_order1 = 0;}
			if($timestamp_order2 < 0){$timestamp_order2 = 0;}
		}else{
			$timestamp_order1 = 0;
			$timestamp_order2 = 9999900000;
		}
		
		if($statuses == ''){
			$statuses = 'in_processing,needs_confirmation,in_work,ready_for_shipment,shipped,in_shipment,canceled';
		}
		if($statuses == 'everything_except_drafts'){
			$statuses = 'in_processing,needs_confirmation,in_work,ready_for_shipment,shipped,in_shipment';
		}
		$statuses = preg_replace('/(.+)(,|$)/U', '"$1",', $statuses);
		$statuses = preg_replace('/,$/', '', $statuses);
		
		$op0 = ($statuses == '"draft"' ? '=' : '!=');
		$op1 = ($responsible_id != '' ? '=' : '!=');
		$op2 = ($counterparty_id != '' ? '=' : '!=');
		
		switch($payment){
			case '':
				$payment = '-';
				$op3 = '!=';
				break;
			case 'cash_on_delivery':
				$payment = '1';
				$op3 = '=';
				break;
			case 'prepayment':
				$payment = '1';
				$op3 = '!=';
				break;
		}
		
		$op4 = ($shipping_warehouse_id != '' ? '=' : '!=');
		$op5 = ($responsible_sokrof_id != '' ? '=' : '!=');
		
		switch($sort){
			case 'order_date_new_first':
				$order = 'DESC';
				$sign = '<';
				break;
			case 'order_date_old_first':
			case 'shipping_date_is_earlier':
			case 'shipping_date_later':
				$order = 'ASC';
				$sign = '>';
				break;
		}
		
		try{
			
			if(!Schema::hasTable('orders_'.$main_counterparty_id)){
				// вот этот говнокод пришлось написать потому что наш фронтендер - ленивая задница
				return ['error'=>'Не удалось найти таблицу с данными заказов ('.$main_counterparty_id.')'];
				//
			}
			
			switch($sort){
				
				case 'order_date_new_first':
				
					$result = DB::select('SELECT `id` FROM `orders_'.$main_counterparty_id.'` WHERE `timestamp_order` <= :timestamp_order2 ORDER BY `id` DESC LIMIT 1', ['timestamp_order2' => $timestamp_order2]);
					foreach ($result as $row) {
						$id = ($row->id - ($limit * ($page - 1))) + 1;
					}
				
					break;
					
				case 'order_date_old_first':
				case 'shipping_date_is_earlier':
				case 'shipping_date_later':
				
					$result = DB::select('SELECT `id` FROM `orders_'.$main_counterparty_id.'` WHERE `timestamp_order` >= :timestamp_order1 ORDER BY `id` ASC LIMIT 1', ['timestamp_order1' => $timestamp_order1]);
					foreach ($result as $row) {
						$id = ($row->id + ($limit * ($page - 1))) - 1;
					}
				
					break;
											
			}
					
			$result = DB::select('SELECT `timestamp_shipments`, `date`, `order_id`, `order_number`, `status`, `counterparty_id`, `sum`, `is_cash_payment`, `shipping_date`, `shipping_warehouse_id`, CONVERT(AES_DECRYPT(`responsible_sokrof`, :aes_key) USING utf8mb4) AS `responsible_sokrof`, `client_id` FROM `orders_'.$main_counterparty_id.'` WHERE `timestamp_order` >= :timestamp_order1 AND `timestamp_order` <= :timestamp_order2 AND `id` > 1 AND `id` '.$sign.' :id AND `status` '.$op0.' \'draft\' AND `status` IN ('.$statuses.') AND `client_id` '.$op1.' :client_id AND `counterparty_id` '.$op2.' :counterparty_id AND `is_cash_payment` '.$op3.' :payment AND `shipping_warehouse_id` '.$op4.' :shipping_warehouse_id  ORDER BY `date` '.$order.' LIMIT :limit', ['aes_key' => $this->aes_key[0], 'timestamp_order1' => $timestamp_order1, 'timestamp_order2' => $timestamp_order2, 'id' => $id, 'client_id' => $responsible_id, 'counterparty_id' => $counterparty_id, 'payment' => $payment, 'shipping_warehouse_id' => $shipping_warehouse_id, 'limit' => $limit]);
			
			$result2 = DB::select('SELECT `id` FROM `orders_'.$main_counterparty_id.'` WHERE `id` > 1 AND `timestamp_order` >= :timestamp_order1 AND `timestamp_order` <= :timestamp_order2 AND `status` '.$op0.' \'draft\' AND `status` IN ('.$statuses.') AND `client_id` '.$op1.' :client_id AND `counterparty_id` '.$op2.' :counterparty_id AND `is_cash_payment` '.$op3.' :payment AND `shipping_warehouse_id` '.$op4.' :shipping_warehouse_id  ORDER BY `date` '.$order, ['timestamp_order1' => $timestamp_order1, 'timestamp_order2' => $timestamp_order2, 'client_id' => $responsible_id, 'counterparty_id' => $counterparty_id, 'payment' => $payment, 'shipping_warehouse_id' => $shipping_warehouse_id]);
			
		} catch (QueryException $e) {
			$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
			if(strpos($err, 'Base table or view not found') === false){
				$this->log_er_mysql($err);
				return ['error'=>$err];
			}
		}
		
		$pagination_max_page = ceil(sizeof($result2) / $limit);
		$pagination_max_page = ($pagination_max_page < 1 ? 1 : $pagination_max_page);
		$client_ids = '';
		$arr = [];
		
		foreach ($result as $row) {
			
			$arr[] = ['timestamp_shipments' => $row->timestamp_shipments, 'date' => $this->convert_format_date2($row->date), 'order_id' => $row->order_id, 'order_number' => $row->order_number, 'status' => $row->status, 'counterparty_id' => $row->counterparty_id, 'sum' => (float) $row->sum, 'is_cash_payment' => $row->is_cash_payment, 'shipping_date' => str_replace('01 янв 0001', '', $this->convert_format_date2($row->shipping_date)), 'shipping_warehouse_id' => $row->shipping_warehouse_id, 'responsible_sokrof' => $row->responsible_sokrof, 'client_id' => $row->client_id];
			
			if(strpos($client_ids, $row->client_id) === false){
				$client_ids .= '"'.$row->client_id.'",';
			}
			
		}
		$client_ids = preg_replace('/,$/', '', $client_ids);
		
		if(sizeof($arr) > 0){
			
			if($sort == 'shipping_date_is_earlier' || $sort == 'shipping_date_later'){
				
				$obj = new \Timsort();
				$arr = $obj->sort($arr, 'timestamp_shipments');
				
				if($sort == 'shipping_date_is_earlier'){
					$arr = array_reverse($arr);
				}
				
			}
			
			try{
				$result = DB::select('SELECT `user_myid`, CONVERT(AES_DECRYPT(`fio`, :aes_key) USING utf8mb4) AS `fio` FROM `users` WHERE `user_myid` IN ('.$client_ids.')', ['aes_key' => $this->aes_key[0]]);
			} catch (QueryException $e) {
				$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
				$this->log_er_mysql($err);
				return ['error'=>$err];
			}
			
			$arr2 = [];
			
			foreach ($arr as $row) {
				
				if(array_key_exists($row['client_id'], $arr2)){
					
					$client_fio = $arr2[$row['client_id']]['client_fio'];
					$arr_orders[] = ['date' => $row['date'], 'order_id' => $row['order_id'], 'order_number' => $row['order_number'], 'status' => $row['status'], 'counterparty_id' => $row['counterparty_id'], 'sum' => $row['sum'], 'is_cash_payment' => $row['is_cash_payment'], 'shipping_date' => $row['shipping_date'], 'shipping_warehouse_id' => $row['shipping_warehouse_id'], 'responsible_sokrof' => $row['responsible_sokrof'], 'client_fio' => $client_fio];
					continue;
					
				}
				
				$client_fio = '';
				
				foreach ($result as $row2) {
					
					if($row['client_id'] == $row2->user_myid){
						
						preg_match('/([^ ]+) ([^ ]+) ([^ ]+)/', $row2->fio, $matches);
						if($matches){
							$client_fio = mb_strtoupper(mb_substr($matches[2], 0, 1)) . '. ' . mb_strtoupper(mb_substr($matches[1], 0, 1)) . mb_strtolower(mb_substr($matches[1], 1, 255));
						}else{
							$client_fio = '';
						}
						break;
						
					}			
					
				}
				
				$arr_orders[] = ['date' => $row['date'], 'order_id' => $row['order_id'], 'order_number' => $row['order_number'], 'status' => $row['status'], 'counterparty_id' => $row['counterparty_id'], 'sum' => $row['sum'], 'is_cash_payment' => $row['is_cash_payment'], 'shipping_date' => $row['shipping_date'], 'shipping_warehouse_id' => $row['shipping_warehouse_id'], 'responsible_sokrof' => $row['responsible_sokrof'], 'client_fio' => $client_fio];						
				$arr2[$row['client_id']] = ['client_fio' => $client_fio];
				
			}
			
		}
		
		return array('data' => $arr_orders, 'pagination_max_page' => $pagination_max_page);
		
	}

	protected function get_shipments(string $main_counterparty_id, int $page, int $limit, string $planned_date1 = '', string $planned_date2 = '', string $statuses = 'in_processing,processed,canceled', string $shipment_type = '', string $responsible_id = '', string $counterparty_id = '', string $shipping_warehouse_id = '', string $responsible_sokrof_id = '', string $sort = 'shipping_date_is_earlier') : array {
		
		$pagination_max_page = 1;
		$arr_shipments = [];
		$result = [];
		$result2 = [];
		$id = 0;
	
		if($planned_date1 != ''){
			$timestamp_planned1 = date('U', strtotime($planned_date1));
			$timestamp_planned2 = date('U', strtotime($planned_date2)) + 60;
			if($timestamp_planned1 < 0){$timestamp_planned1 = 0;}
			if($timestamp_planned2 < 0){$timestamp_planned2 = 0;}
		}else{
			$timestamp_planned1 = 0;
			$timestamp_planned2 = 9999900000;
		}
		
		$op1 = ($responsible_id != '' ? '=' : '!=');
		$op2 = ($counterparty_id != '' ? '=' : '!=');
		$op4 = ($shipping_warehouse_id != '' ? '=' : '!=');
		$op5 = ($responsible_sokrof_id != '' ? '=' : '!=');
		$op6 = ($shipment_type == 'delivery' ? '!= \'\'' : ($shipment_type == 'pickup' ? '= \'\'' : '!= \'-\''));
		
		if($statuses == ''){
			$statuses = 'in_processing,processed,canceled';
		}
		$statuses = preg_replace('/(.+)(,|$)/U', '"$1",', $statuses);
		$statuses = preg_replace('/,$/', '', $statuses);
		$result = [];
		$result2 = [];
		
		try{

			$result = DB::select('SELECT `id` FROM `shipments_'.$main_counterparty_id.'` WHERE `timestamp_shipments` <= :timestamp_planned2 ORDER BY `id` DESC LIMIT 1', ['timestamp_planned2' => $timestamp_planned2]);
			foreach ($result as $row) {
				$id = ($row->id - ($limit * ($page - 1))) + 1;
			}

			$result = DB::select('SELECT `timestamp_shipments`, `shipping_date`, `shipment_id`, `shipment_number`, `status`, `delivery_address_id`, `shipping_warehouse_id`, `counterparty_id`, `sum`, `weight`, CONVERT(AES_DECRYPT(`responsible_sokrof`, :aes_key) USING utf8mb4) AS `responsible_sokrof`, `client_id` FROM `shipments_'.$main_counterparty_id.'` WHERE `timestamp_shipments` >= :timestamp_planned1 AND `timestamp_shipments` <= :timestamp_planned2 AND `id` > 1 AND `id` < :id AND `status` IN ('.$statuses.') AND `client_id` '.$op1.' :client_id AND `counterparty_id` '.$op2.' :counterparty_id AND `shipping_warehouse_id` '.$op4.' :shipping_warehouse_id  AND `delivery_address_id` '.$op6.' ORDER BY `id` DESC LIMIT :limit', ['aes_key' => $this->aes_key[0], 'timestamp_planned1' => $timestamp_planned1, 'timestamp_planned2' => $timestamp_planned2, 'id' => $id, 'client_id' => $responsible_id, 'counterparty_id' => $counterparty_id, 'shipping_warehouse_id' => $shipping_warehouse_id,  'limit' => $limit]);

			$result2 = DB::select('SELECT `id` FROM `shipments_'.$main_counterparty_id.'` WHERE `id` > 1 AND `timestamp_shipments` >= :timestamp_planned1 AND `timestamp_shipments` <= :timestamp_planned2 AND `status` IN ('.$statuses.') AND `client_id` '.$op1.' :client_id AND `counterparty_id` '.$op2.' :counterparty_id AND `shipping_warehouse_id` '.$op4.' :shipping_warehouse_id AND  `delivery_address_id` '.$op6.' ORDER BY `id` DESC', ['timestamp_planned1' => $timestamp_planned1, 'timestamp_planned2' => $timestamp_planned2, 'client_id' => $responsible_id, 'counterparty_id' => $counterparty_id, 'shipping_warehouse_id' => $shipping_warehouse_id]);
			
		} catch (QueryException $e) {
			$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
			if(strpos($err, 'Base table or view not found') === false){
				$this->log_er_mysql($err);
				return ['error'=>$err];
			}
		}

		$pagination_max_page = ceil(sizeof($result2) / $limit);
		$pagination_max_page = ($pagination_max_page < 1 ? 1 : $pagination_max_page);
		$arr = [];
		$client_ids = '';

		foreach ($result as $row) {
			
			$arr[] = ['timestamp_shipments' => $row->timestamp_shipments, 'shipping_date' => str_replace('01 янв 0001', '', $this->convert_format_date2($row->shipping_date)), 'shipment_id' => $row->shipment_id, 'shipment_number' => $row->shipment_number, 'status' => $row->status, 'delivery_address_id' => $row->delivery_address_id, 'shipping_warehouse_id' => $row->shipping_warehouse_id, 'counterparty_id' => $row->counterparty_id, 'sum' => (int) $row->sum, 'weight' => (float) $row->weight, 'responsible_sokrof' => $row->responsible_sokrof, 'client_id' => $row->client_id];
			
			if(strpos($client_ids, $row->client_id) === false){
				$client_ids .= '"'.$row->client_id.'",';
			}
			
		}
		$client_ids = preg_replace('/,$/', '', $client_ids);
		
		if(sizeof($arr) > 0){
			
			$obj = new \Timsort();
			$arr = $obj->sort($arr, 'timestamp_shipments');
			
			if($sort == 'shipping_date_later'){
				$arr = array_reverse($arr);
			}
				
			try{
				$result = DB::select('SELECT `user_myid`, CONVERT(AES_DECRYPT(`fio`, :aes_key) USING utf8mb4) AS `fio` FROM `users` WHERE `user_myid` IN ('.$client_ids.')', ['aes_key' => $this->aes_key[0]]);
			} catch (QueryException $e) {
				$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
				$this->log_er_mysql($err);
				return ['error'=>$err];
			}
			
			$arr2 = [];
			
			foreach ($arr as $row) {
				
				if(array_key_exists($row['client_id'], $arr2)){
					
					$client_fio = $arr2[$row['client_id']]['client_fio'];
					$arr_shipments[] = ['shipping_date' => $row['shipping_date'], 'shipment_id' => $row['shipment_id'], 'shipment_number' => $row['shipment_number'], 'status' => $row['status'], 'delivery_address_id' => $row['delivery_address_id'], 'shipping_warehouse_id' => $row['shipping_warehouse_id'], 'counterparty_id' => $row['counterparty_id'], 'sum' => $row['sum'], 'weight' => $row['weight'], 'responsible_sokrof' => $row['responsible_sokrof'], 'client_fio' => $client_fio];
					continue;
					
				}
				
				$client_fio = '';
				
				foreach ($result as $row2) {
					
					if($row['client_id'] == $row2->user_myid){
						
						preg_match('/([^ ]+) ([^ ]+) ([^ ]+)/', $row2->fio, $matches);
						if($matches){
							$client_fio = mb_strtoupper(mb_substr($matches[2], 0, 1)) . '. ' . mb_strtoupper(mb_substr($matches[1], 0, 1)) . mb_strtolower(mb_substr($matches[1], 1, 255));
						}else{
							$client_fio = '';
						}
						break;
						
					}
					
				}
				
				$arr_shipments[] = ['shipping_date' => $row['shipping_date'], 'shipment_id' => $row['shipment_id'], 'shipment_number' => $row['shipment_number'], 'status' => $row['status'], 'delivery_address_id' => $row['delivery_address_id'], 'shipping_warehouse_id' => $row['shipping_warehouse_id'], 'counterparty_id' => $row['counterparty_id'], 'sum' => $row['sum'], 'weight' => $row['weight'], 'responsible_sokrof' => $row['responsible_sokrof'], 'client_fio' => $client_fio];						
				$arr2[$row['client_id']] = ['client_fio' => $client_fio];			
				
			}
			
		}
		
		return array('data' => $arr_shipments, 'pagination_max_page' => $pagination_max_page);
		
	}

	protected function get_delivery_addresses(string $token) : array {
		
		list($result, $err) = $this->post_request_to_api_1c('get_delivery_addresses', ['token' => $token]);
		if($err){
			return array('error'=>$this->escape_unicode_decode($err));
		}
		
		if(array_key_exists('Ошибка', $result)){
			return array('error'=>($this->escape_unicode_decode($result['Ошибка'])));
		}
		
		if(!is_array($result)){
			return array('error'=>'RESULT_IS_NOT_ARRAY');
		}

		return array('data' => $result);
		
	}
	
	protected function get_counterparties(string $main_counterparty_id) : array {
		
		$data_ = [];
		
		try{
			
			if(Schema::hasTable('counterparties_'.$main_counterparty_id)){
				
				$result = DB::select('SELECT `counterparty_id`, `application_id`, CONVERT(AES_DECRYPT(`fullname`, :aes_key) USING utf8mb4) AS `fullname`, CONVERT(AES_DECRYPT(`inn`, :aes_key2) USING utf8mb4) AS `inn`, CONVERT(AES_DECRYPT(`kpp`, :aes_key3) USING utf8mb4) AS `kpp`, CONVERT(AES_DECRYPT(`ogrn`, :aes_key4) USING utf8mb4) AS `ogrn`, CONVERT(AES_DECRYPT(`legal_address`, :aes_key5) USING utf8mb4) AS `legal_address`, CONVERT(AES_DECRYPT(`actual_address`, :aes_key6) USING utf8mb4) AS `actual_address`, CONVERT(AES_DECRYPT(`corr_account`, :aes_key7) USING utf8mb4) AS `corr_account`, CONVERT(AES_DECRYPT(`bank_bik`, :aes_key8) USING utf8mb4) AS `bank_bik`, CONVERT(AES_DECRYPT(`bank_name`, :aes_key9) USING utf8mb4) AS `bank_name`, CONVERT(AES_DECRYPT(`checking_account`, :aes_key10) USING utf8mb4) AS `checking_account`, `bonus_percentage`, `id_delivery_addresses`, `is_confirmed` FROM `counterparties_'.$main_counterparty_id.'` WHERE `id` > 1', ['aes_key' => $this->aes_key[0], 'aes_key2' => $this->aes_key[0], 'aes_key3' => $this->aes_key[0], 'aes_key4' => $this->aes_key[0], 'aes_key5' => $this->aes_key[0], 'aes_key6' => $this->aes_key[0], 'aes_key7' => $this->aes_key[0], 'aes_key8' => $this->aes_key[0], 'aes_key9' => $this->aes_key[0], 'aes_key10' => $this->aes_key[0]]);
		
				foreach ($result as $row) {
					$data_[] = ['counterparty_id' => $row->counterparty_id, 'application_id' => $row->application_id, 'fullname' => $row->fullname, 'inn' => $row->inn, 'kpp' => $row->kpp, 'ogrn' => $row->ogrn, 'legal_address' => $row->legal_address, 'actual_address' => $row->actual_address, 'corr_account' => $row->corr_account, 'bank_bik' => $row->bank_bik, 'bank_name' => $row->bank_name, 'checking_account' => $row->checking_account, 'bonus_percentage' => $row->bonus_percentage, 'id_delivery_addresses' => $row->id_delivery_addresses, 'is_confirmed' => $row->is_confirmed ];
				}
			
			}
			
		} catch (QueryException $e) {
			
			$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
			$this->log_er_mysql($err);
			return ['error'=>$err];
			
		}
		
		return array('data' => $data_);
		
	}
	
	protected function get_shipment_warehouses() : array {

		$warehouses = [];
		
		try{
			
			$result = DB::select('SELECT SQL_CACHE `data` FROM `warehouses` WHERE `id` = 1 AND `data` != \'\' LIMIT 1');
			
			foreach ($result as $row) {
				$warehouses = json_decode($row->data, true);
			}
			
		} catch (QueryException $e) {
			$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
			$this->log_er_mysql($err);
			return ['error'=>$err];
		}	
		
		$arr = [];
		foreach($warehouses as $c){
			if($c['СкладНекондиции']){
				$c['Наименование'] = $c['Наименование'].' (некодн.)';
			}
			$arr[] = $c;
		}
		$warehouses = $arr;
		
		return array('data' => $warehouses);
		
	}

	protected function get_product_catalog($include_unavailable = false) : array {
		
		$product_catalog = [];
		$arr = [];
		
		try{
			
			$result = DB::select('SELECT SQL_CACHE `data` FROM `product_catalog` WHERE `id` = 1 AND `data` != \'\' LIMIT 1');
			
			foreach ($result as $row) {
				$product_catalog = json_decode($row->data, true);
			}
			foreach($product_catalog as $c){
				if(!$include_unavailable) {

					$products = [];

					if(!empty($c['Данные']))
					{
						foreach($c["Данные"] as $item) {
							if(array_key_exists('НедоступноДляВыбора',$item) && !$item['НедоступноДляВыбора'])
							{
								$products[] = $item;
							}
						}
					}

					if(!empty($products))
					{
						$c['Данные'] = $products;
						$arr[] = $c;
					}

				} else {
					$arr[] = $c;
				}
			}
			if(sizeof($arr) > 0){
				$product_catalog = $arr;
				$arr = [];
			}
			
		} catch (QueryException $e) {
			$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
			$this->log_er_mysql($err);
			return ['error'=>$err];
		}	

		return array('data' => $product_catalog);
		
	}
	
