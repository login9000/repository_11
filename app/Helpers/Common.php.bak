	protected function get_all_notifications() : array {
		
		$user_myid = preg_replace('/[^a-f0-9\-]/', '', $_COOKIE['user_myid'] ?? '');
		$page = preg_replace('/[^0-9]/', '', $_GET['page'] ?? '');
		$order_id = preg_replace('/[^a-f0-9\-]/', '', substr($_GET['order_id'] ?? '', 0, 36));
				
		if(preg_match('/^[0-9]{6,}$/', $page)){
			return array('error'=>'FAIL_PAGE');
		}
		
		$page = (int) $page;	
		$arr_notifications = [];
		$pagination_max_page = 1;
		$result2 = [];
		$limit = 10; 
		
		try{
				
			$max_id = DB::table('notifications_'.$user_myid)->max('id');
			$max_id++;
			
			if($order_id != ''){
				$result = DB::select('SELECT `id`, `date`, `counterparty_id`, `document_id`, `category`, CONVERT(AES_DECRYPT(`subject`, :aes_key) USING utf8mb4) AS `subject`, CONVERT(AES_DECRYPT(`message`, :aes_key2) USING utf8mb4) AS `message`, `is_unread` FROM `notifications_'.$user_myid.'` WHERE `id` > 1 AND `id` < :last_id AND `document_id` = :order_id ORDER BY `id` DESC LIMIT :limit', ['aes_key' => $this->aes_key[0], 'aes_key2' => $this->aes_key[0], 'last_id' => ($max_id - ($limit * ($page - 1))), 'order_id' => $order_id, 'limit' => $limit]);
			}else{
				$result = DB::select('SELECT `id`, `date`, `counterparty_id`, `document_id`, `category`, CONVERT(AES_DECRYPT(`subject`, :aes_key) USING utf8mb4) AS `subject`, CONVERT(AES_DECRYPT(`message`, :aes_key2) USING utf8mb4) AS `message`, `is_unread` FROM `notifications_'.$user_myid.'` WHERE `id` > 1 AND `id` < :last_id ORDER BY `id` DESC LIMIT :limit', ['aes_key' => $this->aes_key[0], 'aes_key2' => $this->aes_key[0], 'last_id' => ($max_id - ($limit * ($page - 1))), 'limit' => $limit]);
			}
			
			if($order_id != ''){
				$result2 = DB::select('SELECT `id` FROM `notifications_'.$user_myid.'` WHERE `id` > 1 AND `document_id` = :order_id ORDER BY `id` DESC', ['order_id' => $order_id]);
			}else{
				$result2 = DB::select('SELECT `id` FROM `notifications_'.$user_myid.'` WHERE `id` > 1 ORDER BY `id` DESC');
			}
			
			foreach ($result as $row) {
				$arr_notifications[] = ['id' => $row->id, 'date' => $row->date, 'counterparty_id' => $row->counterparty_id, 'document_id' => $row->document_id, 'category' => $row->category, 'subject' => $row->subject, 'message' => $row->message, 'is_unread' => $row->is_unread];
			}
			
		} catch (QueryException $e) {
			$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
			if(strpos($err, 'Base table or view not found') === false){
				$this->log_er_mysql($err);
				return ['error'=>$err];
			}
		}

		$pagination_max_page = ceil(sizeof($result2) / $limit);
		$pagination_max_page = ($pagination_max_page < 1 ? 1 : $pagination_max_page);

		foreach($arr_notifications as $num => $notification) {
			$notification['message'] = html_entity_decode($notification['message']);
			$arr_notifications[$num] = $notification;
		}
		
		return array('data' => $arr_notifications, 'pagination_max_page' => $pagination_max_page);
		
	}
	
	protected function get_employees(string $status, string $client_user_myid, string $user_myid) : array {
		
		$employees = [];
		
		try{
			
			$arr = [];
			$arr2 = [];
			$user_myids_ = '';
			$delegation_user_myids_ = '';
			
			$result = DB::select('SELECT * FROM `employees_'.$client_user_myid.'` ORDER BY `id` ASC');
			
			foreach ($result as $row) {
				$user_myids_ .= '"'.$row->user_myid.'",';
				if($row->delegation_user_myid != '' && strpos($delegation_user_myids_, $row->delegation_user_myid) === false){
					$delegation_user_myids_ .= '"'.$row->delegation_user_myid.'",';
				}
			}
			
			$user_myids_ = preg_replace('/,$/', '', $user_myids_);
			$delegation_user_myids_ = preg_replace('/,$/', '', $delegation_user_myids_);
						
			if($user_myids_ != ''){
				$result2 = DB::select('SELECT `user_myid`, CONVERT(AES_DECRYPT(`fio`, :aes_key) USING utf8mb4) AS `fio`, CONVERT(AES_DECRYPT(`phone`, :aes_key2) USING utf8mb4) AS `phone`, CONVERT(AES_DECRYPT(`email`, :aes_key3) USING utf8mb4) AS `email` FROM `users` WHERE `user_myid` IN ('.$user_myids_.')', ['aes_key' => $this->aes_key[0], 'aes_key2' => $this->aes_key[0], 'aes_key3' => $this->aes_key[0]]);
				foreach ($result2 as $row) {
					$arr[$row->user_myid] = ['fio' => $row->fio, 'phone' => $row->phone, 'email' => $row->email];
				}
			}

			if($delegation_user_myids_ != ''){
				$result2 = DB::select('SELECT `user_myid`, CONVERT(AES_DECRYPT(`fio`, :aes_key) USING utf8mb4) AS `fio` FROM `users` WHERE `user_myid` IN ('.$delegation_user_myids_.')', ['aes_key' => $this->aes_key[0]]);
				foreach ($result2 as $row) {
					$arr2[$row->user_myid] = ['fio' => $row->fio];
				}
			}
			
			foreach ($result as $row) {
				
				$fio = '';
				$phone = '';
				$email = '';
				$delegation_fio = '';
				
				if(array_key_exists($row->user_myid, $arr)){
					$fio = $arr[$row->user_myid]['fio'];
					$phone = $arr[$row->user_myid]['phone'];
					$email = $arr[$row->user_myid]['email'];
				}
				
				if($phone == ''){
					continue;
				}
				
				if(array_key_exists($row->delegation_user_myid, $arr2)){
					$delegation_fio = $arr2[$row->delegation_user_myid]['fio'];
				}
				
				if($delegation_fio != ''){
					preg_match('/([^ ]+) ([^ ]+) ([^ ]+)/', $delegation_fio, $matches);
					if($matches){
						$delegation_fio = mb_strtoupper(mb_substr($matches[1], 0, 1)) . mb_strtolower(mb_substr($matches[1], 1, 255)) . ' ' . mb_strtoupper(mb_substr($matches[2], 0, 1)) . '.' . mb_strtoupper(mb_substr($matches[3], 0, 1)) . '.';
					}else{
						$delegation_fio = '';
					}
				}else{
					$delegation_fio = '';
				}
				
				preg_match('/([^ ]+) ([^ ]+) ([^ ]+)/', $fio, $matches);
				if($matches){
					$fio2 = mb_strtoupper(mb_substr($matches[2], 0, 1)) . '. ' . mb_strtoupper(mb_substr($matches[1], 0, 1)) . mb_strtolower(mb_substr($matches[1], 1, 255));
				}else{
					$fio2 = '';
				}
				
				if($status == 'ОсновнойПрофиль' || $status == 'Администратор'){
					
					$employees[] = ['phone' => '+7'.$phone, 'user_myid' => $row->user_myid, 'email' => $email, 'fio' => $fio, 'fio2' => $fio2,  'delegation_user_myid' => $row->delegation_user_myid, 'delegation_fio' => $delegation_fio, 'is_banned' => $row->is_banned];
					
				}
				
				if($status == 'Сотрудник'){

					$employees[] = ['user_myid' => $row->user_myid, 'fio2' => $fio2];
					
				}
					
			}
			
		} catch (QueryException $e) {
			$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
			if(strpos($err, 'Base table or view not found') === false){
				$this->log_er_mysql($err);
				return ['error'=>$err];
			}
		}
		
		return array('data' => $employees);
		
	}
	
	protected function get_nearest_available_dates(string $token) : array {
		
		list($result, $err) = $this->post_request_to_api_1c('get_nearest_available_delivery_date', ['token' => $token]);
		if($err){
			return array('error'=>$this->escape_unicode_decode($err));
		}
		
		if(array_key_exists('Ошибка', $result)){
			return array('error'=>($this->escape_unicode_decode($result['Ошибка'])));
		}
		
		if(!array_key_exists('Дата', $result)){
			return array('error'=>'NO_EXISTS_KEY_Дата');
		}
		
		$delivery_date = $result['Дата'];
		
		list($result, $err) = $this->post_request_to_api_1c('get_nearest_available_pick_up_date', ['token' => $token]);
		if($err){
			return array('error'=>$this->escape_unicode_decode($err));
		}
		
		if(array_key_exists('Ошибка', $result)){
			return array('error'=>($this->escape_unicode_decode($result['Ошибка'])));
		}
		
		if(!array_key_exists('Дата', $result)){
			return array('error'=>'NO_EXISTS_KEY_Дата');
		}
		
		$pick_up_date = $result['Дата'];
		
		return array('data' => ['delivery_date' => $delivery_date, 'pick-up_date' => $pick_up_date]);
		
	}
	
