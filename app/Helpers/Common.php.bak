	protected function get_update_orders(string $main_counterparty_id) : array {
		
		$update_orders = [];
		
		try{
			
			if(!Schema::hasTable('orders_'.$main_counterparty_id)){
				// вот этот говнокод пришлось написать потому что наш фронтендер - ленивая задница
				return ['error'=>'Не удалось найти таблицу с данными заказов ('.$main_counterparty_id.')'];
				//
			}
			
			$result = DB::select('SELECT `ids_row_update` FROM `orders_'.$main_counterparty_id.'` WHERE `id` = 1 LIMIT 1');
			
			foreach ($result as $row) {
				
				$ids_row_update = '';
				
				if($row->ids_row_update != ''){
					
					DB::beginTransaction();

						# блокируем всю таблицу в рамках транзакции
						DB::select('SELECT COUNT(`id`) FROM `orders_'.$main_counterparty_id.'` FOR UPDATE');
						
						$result = DB::select('SELECT `ids_row_update` FROM `orders_'.$main_counterparty_id.'` WHERE `id` = 1 LIMIT 1');
						foreach ($result as $row) {
							$ids_row_update = preg_replace('/(.+)(,|$)/U', '"$1",', $row->ids_row_update);
							$ids_row_update = preg_replace('/,$/', '', $ids_row_update);
						}
						
						DB::update('UPDATE `orders_'.$main_counterparty_id.'` SET `ids_row_update` = \'\' WHERE `id` = 1 LIMIT 1');
						
						if($ids_row_update != ''){
							$result = DB::select('SELECT `order_id`, `status` FROM `orders_'.$main_counterparty_id.'` WHERE `order_id` IN ('.$ids_row_update.')');
							foreach ($result as $row) {
								$update_orders[] = ['order_id' => $row->order_id, 'status' => $row->status];
							}
						}
						
					DB::commit();
					
				}
				
			}
			
		} catch (QueryException $e) {
							
			DB::rollBack();
			$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
			if(strpos($err, 'Base table or view not found') === false){
				$this->log_er_mysql($err);
				return ['error'=>$err];
			}
			
		}
		
		return array('data' => $update_orders);
		
	}
	
	protected function get_update_shipments(string $main_counterparty_id) : array {
		
		$update_shipments = [];
		$count = '';
		
		try{
			
			$result = DB::select('SELECT `ids_row_update` FROM `shipments_'.$main_counterparty_id.'` WHERE `id` = 1 LIMIT 1');
			
			foreach ($result as $row) {
				
				$ids_row_update = '';
				
				if($row->ids_row_update != ''){
					
					DB::beginTransaction();

						# блокируем всю таблицу в рамках транзакции
						DB::select('SELECT COUNT(`id`) FROM `shipments_'.$main_counterparty_id.'` FOR UPDATE');
						
						$result = DB::select('SELECT `ids_row_update` FROM `shipments_'.$main_counterparty_id.'` WHERE `id` = 1 LIMIT 1');
						foreach ($result as $row) {
							$ids_row_update = preg_replace('/(.+)(,|$)/U', '"$1",', $row->ids_row_update);
							$ids_row_update = preg_replace('/,$/', '', $ids_row_update);
						}
						
						DB::update('UPDATE `shipments_'.$main_counterparty_id.'` SET `ids_row_update` = \'\' WHERE `id` = 1 LIMIT 1');
						
						$result = DB::select('SELECT `shipment_id`, `status` FROM `shipments_'.$main_counterparty_id.'` WHERE `shipment_id` IN ('.$ids_row_update.')');
						foreach ($result as $row) {
							$update_shipments[] = ['shipment_id' => $row->shipment_id, 'status' => $row->status];
						}
					
					DB::commit();
					
				}
				
			}
		
			$count = DB::table('shipments_'.$main_counterparty_id)->distinct()->count('shipment_number');
			$count--;
			if($count > 99){
				$count = '99+';
			}
			$count = (string) $count;
			
		} catch (QueryException $e) {
							
			DB::rollBack();
			$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
			if(strpos($err, 'Base table or view not found') === false){
				$this->log_er_mysql($err);
				return ['error'=>$err];
			}
			
		}
		
		return array('total_shipments' => $count, 'data' => $update_shipments);
		
	}
	
