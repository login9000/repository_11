	protected function send_notification(string $user_myid, array $data) : array {
		
		$mysqli = @new \mysqli(env('DB_HOST'), env('DB_USERNAME'), env('DB_PASSWORD'), env('DB_DATABASE'));		
		if($mysqli->connect_error) {
			$err = $mysqli->connect_error;
			$this->log_er_mysql($err);
			return array(null, preg_replace('/\r?\n/', ' ', $err));
		}
		
		if(!$mysqli->query('CREATE TABLE `notifications_'.$user_myid.'` (`id` int UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY, `date` char(22) NOT NULL DEFAULT \'\', `counterparty_id` char(36) NOT NULL DEFAULT \'\', `document_id` char(36) NOT NULL DEFAULT \'\', `category` enum(\'buyers_order\',\'shipment_request\',\'official\') NOT NULL DEFAULT \'official\', `subject` blob DEFAULT NULL, `message` blob DEFAULT NULL, `is_unread` char(1) NOT NULL DEFAULT \'1\', `number_unread_notifications` int UNSIGNED NOT NULL DEFAULT 0, `number_new_row` int UNSIGNED NOT NULL DEFAULT 0) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;')){
			$err = $mysqli->error;
			if(strpos($err, 'already exists') === false){
				$this->log_er_mysql($err);
				return array(null, preg_replace('/\r?\n/', ' ', $err));
			}
		}
		
		try{
			
			DB::beginTransaction();

				# блокируем всю таблицу в рамках транзакции
				DB::select('SELECT COUNT(`id`) FROM `notifications_'.$user_myid.'` FOR UPDATE');
				
				if(DB::table('notifications_'.$user_myid)->count('id') == 0){
					DB::insert('INSERT INTO `notifications_'.$user_myid.'` (`number_unread_notifications`, `number_new_row`) values (0, 0)');
				}
				
				DB::update('UPDATE `notifications_'.$user_myid.'` SET `number_unread_notifications` = (`number_unread_notifications` + 1), `number_new_row` = (`number_new_row` + 1) WHERE `id` = 1 LIMIT 1');
				DB::insert('INSERT INTO `notifications_'.$user_myid.'` (`date`, `counterparty_id`, `document_id`, `category`, `subject`, `message`) values (:date, :counterparty_id, :document_id, :category, AES_ENCRYPT(:subject, :aes_key), AES_ENCRYPT(:message, :aes_key2))', $data);
			
			DB::commit();

			
		} catch (QueryException $e) {
			
			DB::rollBack();
			$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
			$this->log_er_mysql($err);
			return array(null, preg_replace('/\r?\n/', ' ', $err));
			
		}
		
		/* try{
			// раскомментировать если все таки выяснится что нужно все таки очищать старые строки с уведомлениями чтобы таблица не разросталась бесконечно, т.е. если в таблице с уведомлениями уже более 10 100 строк то первые 100 строк удалятся
			DB::beginTransaction();

				# блокируем всю таблицу в рамках транзакции
				DB::select('SELECT COUNT(`id`) FROM `notifications_'.$user_myid.'` FOR UPDATE');
				
				if(DB::table('notifications_'.$user_myid)->count('id') > 10100){
					DB::delete('DELETE FROM `notifications_'.$user_myid.'` WHERE `id` > 1 LIMIT 100');
				}
			DB::commit();
			
		} catch (QueryException $e) {
			
			DB::rollBack();
			$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
			$this->log_er_mysql($err);
			return array(null, preg_replace('/\r?\n/', ' ', $err));
			
		} */
		
		return ['ok', null];
		
	}
	
	protected function get_certain_orders(string $main_counterparty_id, string $orders_ids_, string $token) : array {
		
		$orders = [];
		
		if($orders_ids_ != ''){

			$delivery_data = $this->get_delivery_addresses($token);
					
			if(array_key_exists('error', $delivery_data)){
				return ['error'=>$delivery_data['error']];
			}
			
			$arr_delivery_id_address = [];
			foreach ($delivery_data['data'] as $c) {
				$arr_delivery_id_address[$c['АдресДоставкиИД']] = $c['АдресДоставки'];
			}
		
			try{
			
				if(!Schema::hasTable('orders_'.$main_counterparty_id)){
					// вот этот говнокод пришлось написать потому что наш фронтендер - ленивая задница
					return ['error'=>'Не удалось найти таблицу с данными заказов ('.$main_counterparty_id.')'];
					//
				}
			
				$result = DB::select('SELECT `date`, `order_id`, `order_number`, `status`, `sum`, `shipping_date`, `delivery_address_id` FROM `orders_'.$main_counterparty_id.'` WHERE `order_id` IN ('.$orders_ids_.')');
				
				foreach ($result as $row) {
					
					$delivery_city = '';
					if($row->delivery_address_id != ''){
						if(array_key_exists($row->delivery_address_id, $arr_delivery_id_address)){
							$delivery_city = preg_replace('/^[0-9]+, ([^,]+),.+/', '$1', $arr_delivery_id_address[$row->delivery_address_id]);
						}
					}
					
					$orders[] = ['date_create_order' => $this->convert_format_date2($row->date), 'order_id' => $row->order_id, 'order_number' => $row->order_number, 'status' => $row->status, 'sum' => $row->sum, 'shipping_date' => str_replace('01 янв 0001', '', $this->convert_format_date2($row->shipping_date)), 'delivery_city' => $delivery_city];
				}
				
			} catch (QueryException $e) {
				$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
				if(strpos($err, 'Base table or view not found') === false){
					$this->log_er_mysql($err);
					return ['error'=>$err];
				}
			}
		
		}
		
		return array('data' => $orders);
		
	}
	
	protected function prepare_response(array $data, bool $is_escape_unicode_decode = false) : string {
		
		if(array_key_exists('error', $data)){
			if($data['error'] == 'FAIL_USER_MYID' || $data['error'] == 'EXPIRES_TOKEN' || $data['error'] == 'Срок действия токена истек' || $data['error'] == 'Токен заблокирован' || $data['error'] == 'Не найден токен' ){
				header($_SERVER['SERVER_PROTOCOL'].' 401 Unauthorized', true, 401);
			}else{
				header($_SERVER['SERVER_PROTOCOL'].' 400 Bad Request', true, 400);
			}
		}
		if($is_escape_unicode_decode){
			exit($this->escape_unicode_decode(json_encode($data)));
		}
		exit(json_encode($data));
		
	}

	protected function check_shipping_warehouse_id(string $shipping_warehouse_id) : void {
		
		try{

			$result = DB::select('SELECT SQL_CACHE `data` FROM `warehouses` WHERE `id` = 1 LIMIT 1');
			if(sizeof($result) == 0){
				$this->prepare_response(['error'=>'NO_EXISTS_SHIPPING_WAREHOUSE_ID']);
			}
			$is_find = false;
			foreach ($result as $row) {
				$row = json_decode($row->data, true);
				foreach ($row as $c){
					if($c['СкладИД'] == $shipping_warehouse_id){
						$is_find = true;
						break;
					}
				}
			}
			if(!$is_find){
				$this->prepare_response(['error'=>'NO_EXISTS_SHIPPING_WAREHOUSE_ID']);
			}
			
		} catch (QueryException $e) {
			$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
			$this->log_er_mysql($err);
			$this->prepare_response(['error'=>$err]);
		}
		
	}
	
	protected function check_counterparty_id(string $main_counterparty_id, string $counterparty_id) : void {
		
		try{

			if(!Schema::hasTable('counterparties_'.$main_counterparty_id)){
				$this->prepare_response(['error'=>'COULD_NOT_FIND_THE_TABLE_WITH_THE_COUNTERPARTY_DATA', 'comment'=>$main_counterparty_id]);
			}
			
			$result = DB::select('SELECT `is_confirmed` FROM `counterparties_'.$main_counterparty_id.'` WHERE `counterparty_id` = :counterparty_id OR `application_id` = :application_id LIMIT 1', ['counterparty_id' => $counterparty_id, 'application_id' => $counterparty_id]);
			if(sizeof($result) == 0){
				$this->prepare_response(['error'=>'NO_EXISTS_COUNTERPARTY_ID']);
			}
			
		} catch (QueryException $e) {
			$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
			$this->log_er_mysql($err);
			$this->prepare_response(['error'=>$err]);
		}
		foreach ($result as $row) {
			if($row->is_confirmed == ''){
				$this->prepare_response(['error'=>'THIS_COUNTERPARTY_IS_NOT_CONFIRMED']);
			}
		}
		
	}
	
	protected function prepare_result_invoices(string $main_counterparty_id, string $invoices_date1, string $invoices_date2, string $shipment_type, string $counterparty_id, string $shipping_warehouse_id, string $sort, string $client_fio, string $token) : array {
		
		$invoices_data = [];
		$pagination_max_page = 1;
		$limit = 12;
		
		list($result, $err) = $this->post_request_to_api_1c('get_invoices', ['invoices_date1' => $invoices_date1, 'invoices_date2' => $invoices_date2, 'token' => $token]);
		if($err){
			return ['', $err];
		}
		
		if(array_key_exists('Ошибка', $result)){
			return ['', $result['Ошибка']];
		}
		
		if(!is_array($result)){
			return ['', 'RESULT_IS_NOT_ARRAY'];
		}
		
		$shipment_warehouses_data = $this->get_shipment_warehouses();

		if(array_key_exists('error', $shipment_warehouses_data)){
			return ['', $shipment_warehouses_data['error']];
		}
		
		$counterparties_data = $this->get_counterparties($main_counterparty_id);
		
		if(array_key_exists('error', $counterparties_data)){
			return ['', $counterparties_data['error']];
		}
		
		$arr_shipment_warehouses_id_name = [];
		foreach ($shipment_warehouses_data['data'] as $c) {
			$arr_shipment_warehouses_id_name[$c['СкладИД']] = $c['Наименование'];
		}
		
		$arr_counterparties_id_name = [];
		foreach ($counterparties_data['data'] as $c) {
			if($c['counterparty_id'] != ''){
				$arr_counterparties_id_name[$c['counterparty_id']] = $c['fullname'];
			}else if($c['application_id'] != '' && $c['application_id'] != '-'){
				$arr_counterparties_id_name[$c['application_id']] = $c['fullname'];
			}
		}
		
		foreach ($result as $c) {
			
			if(($shipment_type != '') && ($shipment_type == 'pickup' && $c['Доставка'] === true || $shipment_type == 'delivery' && $c['Доставка'] === false)){
				continue;
			}
			if($counterparty_id != '' && $counterparty_id != $c['КонтрагентИД']){
				continue;
			}
			if($shipping_warehouse_id != '' && $shipping_warehouse_id != $c['СкладОтгрузкиИД']){
				continue;
			}
			
			$counterparty_name = '';
			$shipping_warehouse_name = '';
			
			if(array_key_exists($c['КонтрагентИД'], $arr_counterparties_id_name)){
				$counterparty_name = $arr_counterparties_id_name[$c['КонтрагентИД']];
			}
			
			if(array_key_exists($c['СкладОтгрузкиИД'], $arr_shipment_warehouses_id_name)){
				$shipping_warehouse_name = $arr_shipment_warehouses_id_name[$c['СкладОтгрузкиИД']];
			}
			
			$invoices_data[] = ['timestamp_invoices' => ((int) date('U', strtotime($c['Дата']))), 'РасходнаяНакладнаяИД' => $c['РасходнаяНакладнаяИД'], 'Дата' => $this->convert_format_date2($c['Дата']), 'Номер' => $c['Номер'], 'КонтрагентИД' => $c['КонтрагентИД'], 'КонтрагентНаименование' => $counterparty_name, 'НаличнаяОплата' => $c['НаличнаяОплата'], 'СкладОтгрузкиИД' => $c['СкладОтгрузкиИД'], 'СкладОтгрузкиНаименование' => $shipping_warehouse_name, 'Доставка' => $c['Доставка'], 'Вес' => $c['Вес'], 'СуммаДокумента' => $c['СуммаДокумента'], 'АдресДоставки' => $c['АдресДоставки'], 'Sokrof' => '...', 'КлиентФио' => $client_fio];
			
		}
		
		$si = sizeof($invoices_data);
		
		if($si > 0){
			
			$pagination_max_page = ceil($si / $limit);
			$pagination_max_page = ($pagination_max_page < 1 ? 1 : $pagination_max_page);
			
			$obj = new \Timsort();
			$invoices_data = $obj->sort($invoices_data, 'timestamp_invoices');
			
			if($sort == 'invoices_date_new_first'){
				$invoices_data = array_reverse($invoices_data);
			}
			
		}
		
		return [['data' => $invoices_data, 'pagination_max_page' => $pagination_max_page], null];
		
	}
	
	private function log_er_pdf_creator_service(string $mess) : void {
		
		$f = @fopen($this->document_root.'/../storage/logs/errors_pdf_creator_service(php).log', 'a+');
		$text =	date('D M j G:i:s T Y').' '.$this->time . ' '. trim($mess) . PHP_EOL . '----------------------------------------------------------------------------------------'. PHP_EOL;
		@stream_set_write_buffer($f, 0);
		@fwrite($f, $text);
		@fflush($f);
		@fclose($f);
			
	}
	
	protected function pdf_creator_service(string $act, array $data, string $output_link) : array {
		
		$url = '127.0.0.1';
		$port = $this->config_project['pdf_creator_service_port'];
		$path = '/api/v4/create';
		$result = '';
		$err = '';
		$headers = [
			'Accept: */*',
			'Connection: Close',
			'Content-Type: application/json'
		];
		$payload = json_encode(['act' => $act, 'data' => $data, 'output_link' => $output_link]);
		$json = [];
		$full_url = ($port == 443 ? 'https://' : 'http://').$url.($port != 443 && $port != 80 ? ':'.$port : '').$path;
		
		$cl = curl_init();
		if($cl){
			
			for($i = 0; $i < 3; $i++){
					
				$start_time = time();
				
				if($socket = @fsockopen($url, $port, $errorNumber, $errorDescription, $this->config_project['connect_process_timeout2'])){
					
					fclose($socket);
					curl_setopt($cl, CURLOPT_URL, $full_url);
					curl_setopt($cl, CURLOPT_HTTPHEADER, $headers);
					curl_setopt($cl, CURLOPT_POST, true);
					curl_setopt($cl, CURLOPT_POSTFIELDS, $payload);
					curl_setopt($cl, CURLOPT_RETURNTRANSFER, true);
					curl_setopt($cl, CURLOPT_SSL_VERIFYPEER, false);
					curl_setopt($cl, CURLOPT_SSL_VERIFYHOST, 2);
					curl_setopt($cl, CURLOPT_FOLLOWLOCATION, true);
					curl_setopt($cl, CURLOPT_CONNECTTIMEOUT, $this->config_project['connect_process_timeout2']); 
					curl_setopt($cl, CURLOPT_TIMEOUT, $this->config_project['connect_process_timeout2']); 
					$result = curl_exec($cl);
					
					$end_time = time();
					
					if(preg_match('/^\{"(result|error)":/', $result)){
						
						$json = json_decode($result, true);
						
					}else{
						
						$err = substr(htmlspecialchars($result, ENT_QUOTES, $this->encoding), 0, 255);
						$err = preg_replace('/\r?\n/', '', $err);
						
						if($err == ''){
							if($end_time - $start_time >= $this->config_project['connect_process_timeout2']){
								$err = 'CONNECTION_TIMEOUT ('.$full_url.')';
							}else{
								$err = 'RESULT_IS_EMPTY ('.$full_url.')';
							}
							$this->log_er_pdf_creator_service($err);
							continue;
						}
						$this->log_er_pdf_creator_service($err);
						
					}
					
				}else{
					$err = 'FAIL_SOCKET_CONNECT ('.$full_url.')';
					$this->log_er_pdf_creator_service($err);
					continue;
				}

				curl_close($cl);
				unset($cl);
					
				break;
			
			}
			
		}else{
			$err = 'FAIL_CURL_INIT';
			$this->log_er_pdf_creator_service($err);
		}
		
		if($err != ''){
			return ['', $err];
		}
		
		if(array_key_exists('error', $json)){
			return ['', $json['error']];
		}
		
		return ['ok', null];
		
	}
	
	protected function prepare_result_product_remains(string $main_counterparty_id, string $shipping_warehouse_id, string $products, string $profile, string $thickness, string $coating, string $color) : array {
		
		try{
			
			$result = DB::select('SELECT SQL_CACHE `data` FROM `product_remains` WHERE `id` = 1 LIMIT 1');
			
			foreach($result as $row){
				$product_remains = json_decode($row->data, true);
			}
		
		} catch (QueryException $e) {
			$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
			$this->log_er_mysql($err);
			return ['', $err];
		}
		
		$prices_product_catalog_data = $this->get_prices_of_the_main_counterparty($main_counterparty_id);

		if(array_key_exists('error', $prices_product_catalog_data)){
			return ['', $prices_product_catalog_data['error']];
		}
		
		$arr_prices_product_catalog_id_price = [];
		foreach ($prices_product_catalog_data['data'] as $c) {
			foreach($c['Данные'] as $c2){
				$arr_prices_product_catalog_id_price[$c2['НоменклатураИД']] = $c2['Цена'];
			}
		}		

		$product_balances_data = $this->get_product_balances();
		
		if(array_key_exists('error', $product_balances_data)){
			return ['', $product_balances_data['error']];
		}

		$arr_product_balances_id_quantity_and_length = [];
		$is_get_data = false;
		foreach ($product_balances_data['data'] as $c) {
			$id = '';
			foreach ($c as $key => $val) {
				if($key == 'Данные' && $is_get_data){
					$is_get_data = false;
					foreach ($val as $c2) {
						if(!array_key_exists($id.'-'.$c2['НоменклатураИД'], $arr_product_balances_id_quantity_and_length)){
							$arr_product_balances_id_quantity_and_length[$id.'-'.$c2['НоменклатураИД']] = [];
						}
						$arr_product_balances_id_quantity_and_length[$id.'-'.$c2['НоменклатураИД']][] = ['Характеристика' => $c2['Характеристика'] ?? '', 'Количество' => $c2['Количество'], 'КоличествоЛистов' => $c2['КоличествоЛистов']];
					}
					break;
				}
				if($key == 'СкладИД'){
					$id = $val;
					$is_get_data = true;
					continue;
				}
			}
		}
		
		$arr = [];
		$arr3 = [];
		$product_remains2 = [];
		$pagination_max_page = 1;
		$i = 0;
		$limit = 20;
		$actual_date = '';
		
		foreach($product_remains as $c){
			
			$actual_date = $c['Дата'];
			
			if(($c['СкладИД'] == $shipping_warehouse_id) && ($products != '' ? ($c['ОсновнойРазделНаименование'] == $products || $c['РазделНаименование'] == $products) : true)){
				if(array_key_exists('Данные', $c)){
					foreach($c['Данные'] as $c2){
						
						$y = 0;
						
						if(($profile != '' ? (array_key_exists('Профиль', $c2['Свойства']) && $c2['Свойства']['Профиль'] == $profile) : true) && 
						($thickness != '' ? (array_key_exists('Толщина', $c2['Свойства']) && $c2['Свойства']['Толщина'] == $thickness) : true) && 
						($coating != '' ? (array_key_exists('Покрытие', $c2['Свойства']) && $c2['Свойства']['Покрытие'] == $coating) : true) && 
						($color != '' ? (array_key_exists('Цвет', $c2['Свойства']) && $c2['Свойства']['Цвет'] == $color) : true)){
							
							if($c2['НедоступноДляВыбора']){
								continue;
							}
							
							if(in_array($c2['НоменклатураИД'].'-'.$c2['ВидНоменклатурыИД'], $arr3)){
								continue;
							}
							$arr3[] = $c2['НоменклатураИД'].'-'.$c2['ВидНоменклатурыИД'];
							
							while(true){
									
								$i++;
								$id_nomenclature = $c2['НоменклатураИД'];
								
								$arr2 = [
									'НоменклатураИД' => $c2['НоменклатураИД'],
									'НоменклатураНаименование' => $c2['Наименование'],
									'ВидНоменклатурыИД' => $c2['ВидНоменклатурыИД'],
									'ЕдиницаИзмеренияНаименования' => $c2['ЕдиницаИзмеренияНаименования']
								];
								$arr2['Цена'] = [];
								$arr2['Сумма'] = 0;
								$arr2['Итого'] = -1;
								$arr2['Количество'] = 0;
								$arr2['КоличествоЛистов'] = 0;
								$arr2['Характеристика'] = '';
								
								$price = 0;
								if(array_key_exists($id_nomenclature, $arr_prices_product_catalog_id_price)){
									$price = $arr_prices_product_catalog_id_price[$id_nomenclature];
								}
								if($c2['ЕдиницаИзмеренияНаименования'] != 'м2'){
									$arr2['Цена'][] = $price.' руб. / '.$c2['ЕдиницаИзмеренияНаименования'];
									if($c2['КоэффициентПересчетаМетрКвадратные'] > 0){
										$arr2['Цена'][] = round($price / $c2['КоэффициентПересчетаМетрКвадратные'], 2).' руб. / м2';
									}
								}else{
									$arr2['Цена'][] = $price.' руб. / м2';
								}
								
								if(array_key_exists($shipping_warehouse_id.'-'.$id_nomenclature, $arr_product_balances_id_quantity_and_length)){
									$arr2['Характеристика'] = $arr_product_balances_id_quantity_and_length[$shipping_warehouse_id.'-'.$id_nomenclature][$y]['Характеристика'];
									$arr2['Количество'] = $arr_product_balances_id_quantity_and_length[$shipping_warehouse_id.'-'.$id_nomenclature][$y]['Количество'];
									$arr2['КоличествоЛистов'] = $arr_product_balances_id_quantity_and_length[$shipping_warehouse_id.'-'.$id_nomenclature][$y]['КоличествоЛистов'];
								}
								
								if($c2['ЗаполнятьХарактеристику']){
									if($arr2['Характеристика'] == ''){
										$total = $arr2['КоличествоЛистов'] * 0 * $c2['КоэффициентПересчетаКоличества'] / 1000;
									}else{
										$total = $arr2['КоличествоЛистов'] * $arr2['Характеристика'] * $c2['КоэффициентПересчетаКоличества'] / 1000;
									}
									$arr2['Количество'] = $arr2['КоличествоЛистов'];
								}else if($c2['ПродаетсяКомплектами']){
									$total = $arr2['КоличествоЛистов'] * $c2['КоличествоШтукВКомплекте'];
									$arr2['Количество'] = $arr2['КоличествоЛистов'];
								}else{
									$total = $arr2['Количество'];
								}
								$arr2['Итого'] = round($total, 2);
								
								if($arr2['Итого'] > -1 && $price > 0){
									$arr2['Сумма'] = round($arr2['Итого'] * $price, 2);
								}
								
								$arr[] = $arr2;	
									
								$y++;
								
								if(array_key_exists($shipping_warehouse_id.'-'.$id_nomenclature, $arr_product_balances_id_quantity_and_length)){
									if($y >= sizeof($arr_product_balances_id_quantity_and_length[$shipping_warehouse_id.'-'.$id_nomenclature])){
										break;
									}
								}else{
									break;
								}
							
							}
							
						}
						
					}
				}
			}
		}
		
		$pagination_max_page = ceil($i / $limit);
		$pagination_max_page = ($pagination_max_page < 1 ? 1 : $pagination_max_page);
		
		$product_remains2['actual_date'] = $actual_date;
		$product_remains2['data'] = $arr;
		$product_remains2['pagination_max_page'] = $pagination_max_page;
		
		return [$product_remains2, ''];
		
	}
	
