class Common {
	
	protected $config_app;
	protected $ip = '';
	protected $time = '';
	protected $document_root = '';
	protected $date = '';
	protected $user_agent = '';
	protected $rnd = '';
	protected $encoding = 'UTF-8';
	protected $charset = 'utf-8';
		
	public function __construct(){
		
		//date_default_timezone_set('UTC');
		
		$this->config_project = config('project');
		$this->aes_key = config('aes_key');
		$this->ip = $_SERVER['REMOTE_ADDR'] ?? '';
		$this->time = $_SERVER['REQUEST_TIME'] ?? time();
		$this->document_root = $_SERVER['DOCUMENT_ROOT'] ?? '';
		$this->date = date('H i s d m Y');
		$this->user_agent = mb_substr(htmlspecialchars($_SERVER['HTTP_USER_AGENT'] ?? '', ENT_QUOTES, $this->encoding), 0, 250);
		$this->rnd = mt_rand(100000,999000).mt_rand(100000,999000);
		mysqli_report(MYSQLI_REPORT_OFF);
		
	}
	
	public function __get($name){
		return $this->$name;
	}
	
	public function get_meta_tags_() : string {
		
		$result = '<meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0">
<link rel="shortcut icon" href="favicon.png?1" type="image/png">
<meta name="description" content="'.($this->config_project['descriptions']['home']).'">';
		return $result;
		
	}
	
	public function get_detect_js_errors_script() : string {
		
		$result = '<script type="text/javascript">
var last_message_error = \'\';
window.onerror = function(message, source, lineno){
  if(last_message_error != message){
    last_message_error = message;
    (new Image).src=\'/api/v1/js_error?m=\'+message+\'&p=\'+document.location.host+document.location.pathname+\'&f=\'+source+\'&l=\'+lineno+\'&\'+Math.random();
  }
};
</script>';
		return $result;
		
	}
	
	public function smart_caching(string $file_path = '') : string {
		
		if($file_path){
			return $file_path . '?' . @filemtime(realpath(null) . ($file_path[0] != '/' ? '/'.$file_path : $file_path));
		}
		
	}
	
	public function get_js_scripts_and_css_styles(array $arr = []) : string {
		
		$result = '';
		$si = sizeof($arr);
		
		for($i = 0; $i < $si; $i++){
			
			$file = realpath(null) . ($arr[$i][0] != '/' ? '/'.$arr[$i] : $arr[$i]);
			
			if(file_exists($file)){
				
				preg_match('/\.(css|js)$/', $arr[$i], $matches);
				$extension = $matches[1];
				
				if($extension){
					if($extension == 'css'){
						$result .= '<link rel="stylesheet" href="'.$this->smart_caching($arr[$i]).'" type="text/css">';
					}else{
						$result .= '<script type="text/javascript" src="'.$this->smart_caching($arr[$i]).'"></script>';
					}
					
				}
				
			}
			
		}
		
		return $result;
		
	}
	
	public function convert_format_date(string $d ) : string {
		
		$ex = explode(' ',$d);
		$month = str_replace(['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12'], ['янв', 'фев', 'мар', 'апр', 'май', 'июн', 'июл', 'авг', 'сен', 'окт', 'ноя', 'дек'], $ex[4]);
		$number = preg_replace('/^0/','',$ex[3]);
		$year = $ex[5];
		$hour = $ex[0];
		if($hour == '0'){$hour = '00';}
		$minute = $ex[1];
		$seconds = $ex[2];
		$date = $number.' '.$month.' '.$year.' в '.$hour.':'.$minute.':'.$seconds;
		return $date;
		
	}
	
	protected function convert_format_date2(string $d ) : string {

		 $date = $d;
		 preg_match('/([0-9]{4})\-([0-9]{2})\-([0-9]{2})T[0-9]{2}:[0-9]{2}:[0-9]{2}/', $d, $matches);
		 if($matches){
			 $number = $matches[3];
			 $month = str_replace(['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12'], ['янв', 'фев', 'мар', 'апр', 'май', 'июн', 'июл', 'авг', 'сен', 'окт', 'ноя', 'дек'], $matches[2]);
			 $year = $matches[1];
			 $date = $number.' '.$month.' '.$year;
		 }
		 return $date;
		 
	}

	protected function convert_format_date_month_en_to_ru(string $date) {
		return str_replace(['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],['янв', 'фев', 'мар', 'апр', 'мая', 'июн', 'июл', 'авг', 'сен', 'окт', 'ноя', 'дек'], $date);
	}
	
	protected function convert_format_date3(string $d ) : string {

		 $date = $d;
		 preg_match('/([0-9]{4})\-([0-9]{2})\-([0-9]{2})T([0-9]{2}:[0-9]{2}):[0-9]{2}/', $d, $matches);
		 if($matches){
			 $number = $matches[3];
			 $month = str_replace(['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12'], ['янв', 'фев', 'мар', 'апр', 'май', 'июн', 'июл', 'авг', 'сен', 'окт', 'ноя', 'дек'], $matches[2]);
			 $year = $matches[1];
			 $date = $number.' '.$month.' '.$year.' '.$matches[4];
		 }
		 return $date;
		 
	}
	
	public function log_er_flock(string $script_filename, int $line) : void {

		$text = date('D M j G:i:s T Y').' '.$this->time.' ('.$this->ip.') script_filename:'.$script_filename.' line:'.$line . PHP_EOL . '----------------------------------------------------------------------------------------'. PHP_EOL;
		$f = @fopen($this->document_root.'/../storage/logs/errors_flock.log', 'a+');
		if(@flock($f,LOCK_EX)){
			@stream_set_write_buffer($f,0);
			@fwrite($f,$text);
			@fflush($f);
			@flock($f,LOCK_UN);
		}
		@fclose($f);
		
	}

	public function log_er_js() : void {

		$mes = htmlspecialchars($_GET['m'] ?? '', ENT_COMPAT, $this->encoding);
		$page = htmlspecialchars($_GET['p'] ?? '', ENT_COMPAT, $this->encoding);
		$file = htmlspecialchars($_GET['f'] ?? '', ENT_COMPAT, $this->encoding);
		$line = htmlspecialchars($_GET['l'] ?? '', ENT_COMPAT, $this->encoding);
		
		$a = (strpos($this->config_project['ignor_error_mes'], '|'.$mes.'|') !== false);
		$b = false;
		$ex = explode('|', $this->config_project['ignor_error_mes']);
		$si = sizeof($ex) - 1;
		for ($i = 0; $i < $si; $i++) {
			
			if ($ex[$i]) {
				
				if (strpos($this->user_agent, $ex[$i]) !== false) {
					$b = true;
					break;
				}
				
			}
			
		}
		if (!$a && !$b) {
			
			$file_path = $this->document_root.'/../storage/logs/errors_js.log';
			$text = date('D M j G:i:s T Y').' '.$this->time.' ('.$this->ip.') mess:'.$mes.' page:'.$page.' file:'.$file.' line:'.$line.' '.$this->user_agent . PHP_EOL . '----------------------------------------------------------------------------------------'. PHP_EOL;
			
			$f = @fopen($file_path, 'a+');
			if (@flock($f, LOCK_EX)) {
				
				@clearstatcache(true, $file_path);
				$siz = @filesize($file_path);
				if ($siz != 0) {

					$data = @fread($f, $siz);
					$ex = @explode(PHP_EOL, $data);
					$si = @sizeof($ex) - 1;
					if($si > 99000){
						@ftruncate($f, 0);
					}
					
				}
		
				@stream_set_write_buffer($f, 0);
				@fwrite($f, $text);
				@fflush($f);
				@flock($f, LOCK_UN);
				
			}
			else {
				$this->log_er_flock(__FILE__, __LINE__);
			}
			@fclose($f);
		
		}
	
	}
	
	protected function log_er_mysql(string $mess) : void {
		
		$f = @fopen($this->document_root.'/../storage/logs/errors_mysql.log', 'a+');
		$text =	date('D M j G:i:s T Y').' '.$this->time . ' '.	trim($mess) . PHP_EOL . '----------------------------------------------------------------------------------------'. PHP_EOL;
		@stream_set_write_buffer($f, 0);
		@fwrite($f, $text);
		@fflush($f);
		@fclose($f);
			
	}
	
	protected function check_allowed_method(string $method) : void {
		
		if(getenv('REQUEST_METHOD') != $method){
			header($_SERVER['SERVER_PROTOCOL'].' 405 Method Not Allowed', true, 405);
			if(strpos($_SERVER['HTTP_ACCEPT'], 'application/json') !== false){
				exit('{"message":"Method Not Allowed"}');
			}else{
				exit('<html>
<head><title>405 Method Not Allowed</title></head>
<body bgcolor="white">
<center><h1>405 Method Not Allowed</h1></center>
<hr><center>nginx</center>
</body>
</html>
<!-- a padding to disable MSIE and Chrome friendly error page -->
<!-- a padding to disable MSIE and Chrome friendly error page -->
<!-- a padding to disable MSIE and Chrome friendly error page -->
<!-- a padding to disable MSIE and Chrome friendly error page -->
<!-- a padding to disable MSIE and Chrome friendly error page -->
<!-- a padding to disable MSIE and Chrome friendly error page -->');
			}
		}
		
	}

	private function log_er_post_request_to_api_1c(string $mess) : void {

		$f = @fopen($this->document_root.'/../storage/logs/errors_post_request_to_api_1c.log', 'a+');
		$text =	date('D M j G:i:s T Y').' '.$this->time . ' '. trim($mess) . PHP_EOL . '----------------------------------------------------------------------------------------'. PHP_EOL;
		@stream_set_write_buffer($f, 0);
		@fwrite($f, $text);
		@fflush($f);
		@fclose($f);
		
	}
	
	protected function post_request_to_api_1c(string $act, array $data) : array {
		
		set_time_limit(120); // ~ 2 мин.
		
		$url = $this->config_project['url_1с'];
		$path = $this->config_project['path_1с'];
		$port = $this->config_project['port_1с'];
		$result = '';
		$err = '';
