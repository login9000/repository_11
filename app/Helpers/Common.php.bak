							if(strpos($result, '"ПользовательИД":') !== false || strpos($result, '"Ошибка":') !== false){
								$json = json_decode($result, true);
							}
							
							break;
						
						case 'edit_employee':
						
							if(strpos($result, '"Сообщение":') !== false || strpos($result, '"Ошибка":') !== false){
