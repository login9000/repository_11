	protected function get_new_news() : array {
		
		$user_myid = preg_replace('/[^a-f0-9\-]/', '', $_COOKIE['user_myid'] ?? '');
		
		$number_unread = 0;
		$number_new_row_news = 0;
		$arr_news = [];
		
		try{
			
			DB::beginTransaction();
			
			$result = DB::select('SELECT `number_of_unread_news`, `number_new_row_news` FROM `users` WHERE `user_myid` = :user_myid LIMIT 1 FOR UPDATE', ['user_myid' => $user_myid]);
			
			foreach ($result as $row) {
				$number_unread = $row->number_of_unread_news;
				$number_new_row_news = $row->number_new_row_news;
			}
			
			if($number_new_row_news > 0){
				DB::update('UPDATE `users` SET `number_new_row_news` = 0 WHERE `user_myid` = :user_myid LIMIT 1', ['user_myid' => $user_myid]);
			}
			
			DB::commit();
			
			if($number_new_row_news > 0){
				$result = DB::select('SELECT * FROM `news` ORDER BY `id` DESC LIMIT :limit', ['limit' => $number_new_row_news]);
				foreach ($result as $row) {
					$arr_news[] = ['id' => $row->id, 'date' => $row->date, 'header' => $row->header, 'text' => $row->text, 'is_unread' => '1'];
				}
			}
			
		} catch (QueryException $e) {
			
			DB::rollBack();
			$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
			$this->log_er_mysql($err);
			return ['error'=>$err];
			
		}	
		
		return array('number_unread' => $number_unread, 'data' => $arr_news);
		
	}
	
