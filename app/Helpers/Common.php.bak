			$this->log_er_mysql($err);
			return ['', $err];
		}
			
		$prices_product_catalog_data = $this->get_prices_of_the_main_counterparty($main_counterparty_id);

		if(array_key_exists('error', $prices_product_catalog_data)){
			return ['', $prices_product_catalog_data['error']];
		}
		
		$arr_prices_product_catalog_id_price = [];
		foreach ($prices_product_catalog_data['data'] as $c) {
			foreach($c['Данные'] as $c2){
				$arr_prices_product_catalog_id_price[$c2['НоменклатураИД']] = $c2['Цена'];
			}
		}		
		
		$product_balances_data = $this->get_product_balances();
		
		if(array_key_exists('error', $product_balances_data)){
			return ['', $product_balances_data['error']];
		}

		$arr_product_balances_id_quantity_and_length = [];
		$is_get_data = false;
		foreach ($product_balances_data['data'] as $c) {
			$id = '';
			foreach ($c as $key => $val) {
				if($key == 'Данные' && $is_get_data){
					$is_get_data = false;
					foreach ($val as $c2) {
						if(!array_key_exists($id.'-'.$c2['НоменклатураИД'], $arr_product_balances_id_quantity_and_length)){
							$arr_product_balances_id_quantity_and_length[$id.'-'.$c2['НоменклатураИД']] = [];
						}
						$arr_product_balances_id_quantity_and_length[$id.'-'.$c2['НоменклатураИД']][] = ['Характеристика' => $c2['Характеристика'] ?? '', 'Количество' => $c2['Количество'], 'КоличествоЛистов' => $c2['КоличествоЛистов']];
					}
					break;
				}
				if($key == 'СкладИД'){
					$id = $val;
					$is_get_data = true;
					continue;
				}
			}
		}
		
		$arr = [];
		$arr3 = [];
		$finished_products2 = [];
		$pagination_max_page = 1;
		$i = 0;
		$limit = 20;
		$actual_date = '';
		
		foreach($finished_products as $c){
			
			$actual_date = $c['Дата'];
			
			if(($c['СкладИД'] == $shipping_warehouse_id) && ($products != '' ? ($c['ОсновнойРазделНаименование'] == $products || $c['РазделНаименование'] == $products) : true)){
				
				if(array_key_exists('Данные', $c)){
					foreach($c['Данные'] as $c2){
						
						$y = 0;
						
						if(($profile != '' ? (array_key_exists('Профиль', $c2['Свойства']) && $c2['Свойства']['Профиль'] == $profile) : true) && 
						($thickness != '' ? (array_key_exists('Толщина', $c2['Свойства']) && $c2['Свойства']['Толщина'] == $thickness) : true) && 
						($coating != '' ? (array_key_exists('Покрытие', $c2['Свойства']) && $c2['Свойства']['Покрытие'] == $coating) : true) && 
						($color != '' ? (array_key_exists('Цвет', $c2['Свойства']) && $c2['Свойства']['Цвет'] == $color) : true)){
							
							if($c2['НедоступноДляВыбора']){
								continue;
							}
							
							if(in_array($c2['НоменклатураИД'].'-'.$c2['ВидНоменклатурыИД'], $arr3)){
								continue;
							}
							$arr3[] = $c2['НоменклатураИД'].'-'.$c2['ВидНоменклатурыИД'];
							
							while(true){
							
								$i++;
								$id_nomenclature = $c2['НоменклатураИД'];
								
								$arr2 = [
									'НоменклатураИД' => $c2['НоменклатураИД'],
									'НоменклатураНаименование' => $c2['Наименование'],
									'ВидНоменклатурыИД' => $c2['ВидНоменклатурыИД'],
									'ЕдиницаИзмеренияНаименования' => $c2['ЕдиницаИзмеренияНаименования']
								];
								$arr2['Цена'] = [];
								$arr2['Сумма'] = 0;
								$arr2['Итого'] = -1;
								$arr2['Количество'] = 0;
								$arr2['КоличествоЛистов'] = 0;
								$arr2['Характеристика'] = '';
								
								$price = 0;
								if(array_key_exists($id_nomenclature, $arr_prices_product_catalog_id_price)){
									$price = $arr_prices_product_catalog_id_price[$id_nomenclature];
								}
								if($c2['ЕдиницаИзмеренияНаименования'] != 'м2'){
									$arr2['Цена'][] = $price.' руб. / '.$c2['ЕдиницаИзмеренияНаименования'];
									if($c2['КоэффициентПересчетаМетрКвадратные'] > 0){
										$arr2['Цена'][] = round($price / $c2['КоэффициентПересчетаМетрКвадратные'], 2).' руб. / м2';
									}
								}else{
									$arr2['Цена'][] = $price.' руб. / м2';
								}
								
								if(array_key_exists($shipping_warehouse_id.'-'.$id_nomenclature, $arr_product_balances_id_quantity_and_length)){
									$arr2['Характеристика'] = $arr_product_balances_id_quantity_and_length[$shipping_warehouse_id.'-'.$id_nomenclature][$y]['Характеристика'];
									$arr2['Количество'] = $arr_product_balances_id_quantity_and_length[$shipping_warehouse_id.'-'.$id_nomenclature][$y]['Количество'];
									$arr2['КоличествоЛистов'] = $arr_product_balances_id_quantity_and_length[$shipping_warehouse_id.'-'.$id_nomenclature][$y]['КоличествоЛистов'];
								}
								
								if($c2['ЗаполнятьХарактеристику']){
									if($arr2['Характеристика'] == ''){
										$total = $arr2['КоличествоЛистов'] * 0 * $c2['КоэффициентПересчетаКоличества'] / 1000;
									}else{
										$total = $arr2['КоличествоЛистов'] * $arr2['Характеристика'] * $c2['КоэффициентПересчетаКоличества'] / 1000;
									}
									$arr2['Количество'] = $arr2['КоличествоЛистов'];
								}else if($c2['ПродаетсяКомплектами']){
									$total = $arr2['КоличествоЛистов'] * $c2['КоличествоШтукВКомплекте'];
									$arr2['Количество'] = $arr2['КоличествоЛистов'];
								}else{
									$total = $arr2['Количество'];
								}
								$arr2['Итого'] = round($total, 2);
								
								if($arr2['Итого'] > -1 && $price > 0){
									$arr2['Сумма'] = round($arr2['Итого'] * $price, 2);
								}
								
								$arr[] = $arr2;	
								
								$y++;
								
								if(array_key_exists($shipping_warehouse_id.'-'.$id_nomenclature, $arr_product_balances_id_quantity_and_length)){
									if($y >= sizeof($arr_product_balances_id_quantity_and_length[$shipping_warehouse_id.'-'.$id_nomenclature])){
										break;
									}
								}else{
									break;
								}
							
							}
						
						}
						
					}
				}
			}
		}
		
		$pagination_max_page = ceil($i / $limit);
		$pagination_max_page = ($pagination_max_page < 1 ? 1 : $pagination_max_page);
		
		$finished_products2['actual_date'] = $actual_date;
		$finished_products2['data'] = $arr;
		$finished_products2['pagination_max_page'] = $pagination_max_page;
		
		return [$finished_products2, ''];
		
	}
	
	private function log_er_xlsx_creator_service(string $mess) : void {
		
		$f = @fopen($this->document_root.'/../storage/logs/errors_xlsx_creator_service(php).log', 'a+');
		$text =	date('D M j G:i:s T Y').' '.$this->time . ' '. trim($mess) .	PHP_EOL . '----------------------------------------------------------------------------------------'. PHP_EOL;
		@stream_set_write_buffer($f, 0);
		@fwrite($f, $text);
		@fflush($f);
		@fclose($f);
			
	}
	
	protected function xlsx_creator_service(string $act, array $data, string $output_link) : array {
		
		$url = 'xslx-service';
		$port = $this->config_project['xlsx_creator_service_port'];
		$path = '/api/v5/create';
		$result = '';
		$err = '';
		$headers = [
			'Accept: */*',
			'Connection: Close',
			'Content-Type: application/json'
		];
		$payload = json_encode(['act' => $act, 'data' => $data, 'output_link' => $output_link]);
		$json = [];
		$full_url = ($port == 443 ? 'https://' : 'http://').$url.($port != 443 && $port != 80 ? ':'.$port : '').$path;
		
		$cl = curl_init();
		if($cl){
			
			for($i = 0; $i < 3; $i++){
					
				$start_time = time();
				
				if($socket = @fsockopen($url, $port, $errorNumber, $errorDescription, $this->config_project['connect_process_timeout2'])){
					
					fclose($socket);
					curl_setopt($cl, CURLOPT_URL, $full_url);
					curl_setopt($cl, CURLOPT_HTTPHEADER, $headers);
					curl_setopt($cl, CURLOPT_POST, true);
					curl_setopt($cl, CURLOPT_POSTFIELDS, $payload);
					curl_setopt($cl, CURLOPT_RETURNTRANSFER, true);
					curl_setopt($cl, CURLOPT_SSL_VERIFYPEER, false);
					curl_setopt($cl, CURLOPT_SSL_VERIFYHOST, 2);
					curl_setopt($cl, CURLOPT_FOLLOWLOCATION, true);
					curl_setopt($cl, CURLOPT_CONNECTTIMEOUT, $this->config_project['connect_process_timeout2']); 
					curl_setopt($cl, CURLOPT_TIMEOUT, $this->config_project['connect_process_timeout2']); 
					$result = curl_exec($cl);
					
					$end_time = time();
					
					if(preg_match('/^\{"(result|error)":/', $result)){
						
						$json = json_decode($result, true);
						
					}else{
						
						$err = substr(htmlspecialchars($result, ENT_QUOTES, $this->encoding), 0, 255);
						$err = preg_replace('/\r?\n/', '', $err);
						
						if($err == ''){
							if($end_time - $start_time >= $this->config_project['connect_process_timeout2']){
								$err = 'CONNECTION_TIMEOUT ('.$full_url.')';
							}else{
								$err = 'RESULT_IS_EMPTY ('.$full_url.')';
							}
							$this->log_er_xlsx_creator_service($err);
							continue;
						}
						$this->log_er_xlsx_creator_service($err);
						
					}
					
				}else{
					$err = 'FAIL_SOCKET_CONNECT ('.$full_url.')';
					$this->log_er_xlsx_creator_service($err);
					continue;
				}
				
				curl_close($cl);
				unset($cl);
					
				break;
			
			}
			
		}else{
			$err = 'FAIL_CURL_INIT';
			$this->log_er_xlsx_creator_service($err);
		}
		
		if($err != ''){
			return ['', $err];
		}
		
		if(array_key_exists('error', $json)){
			return ['', $json['error']];
		}
		
		return ['ok', null];
		
	}
	
	protected function get_cart_info(string $user_myid, string $target, string $shipping_warehouse_id) : array {
		
		$number_of_positions = 0;
		$total_sum = 0;
		
		try{
		
			$result = DB::select('SELECT `sum`, `other` FROM `cart_'.$user_myid.'` WHERE `target` = :target', ['target' => $target]);
			
			foreach ($result as $row) {
				$j = json_decode($row->other, true);
				if($j !== null){
					if($shipping_warehouse_id == $j['shipping_warehouse_id']){
						$number_of_positions++;
						$total_sum += (float) $row->sum;
					}
				}
			}
		
		} catch (QueryException $e) {
			$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
			if(strpos($err, 'Base table or view not found') === false){
				$this->log_er_mysql($err);
				return ['error' => $err];
			}
		}
		
		return ['data' => ['number_of_positions' => $number_of_positions, 'total_sum' => $total_sum]];
		
	}
	
	protected function prepare_cart_contents(string $user_myid, string $target, string $shipping_warehouse_id) : array {
		
		$shipment_warehouses_data = $this->get_shipment_warehouses();

		if(array_key_exists('error', $shipment_warehouses_data)){
			return ['', '', $shipment_warehouses_data['error']];
		}
		
		$arr_shipment_warehouses_id_name = [];
		foreach ($shipment_warehouses_data['data'] as $c) {
			$arr_shipment_warehouses_id_name[$c['СкладИД']] = $c['Наименование'];
		}
		
		$cart_contents = ['data' => []];
		$shipping_warehouse_name = '';
		
		try{
			
			$result = DB::select('SELECT * FROM `cart_'.$user_myid.'` WHERE `target` = :target ORDER BY `id` DESC', ['target' => $target]);
			if(sizeof($result) == 0){
				return ['', '', 'CART_IS_EMPTY'];
			}
			
			foreach ($result as $row) {
				
				$j = json_decode($row->other, true);
				
				if($shipping_warehouse_id == $j['shipping_warehouse_id']){
						
					if(array_key_exists($j['shipping_warehouse_id'], $arr_shipment_warehouses_id_name)){
						$shipping_warehouse_name = $arr_shipment_warehouses_id_name[$j['shipping_warehouse_id']];
					}
				
					$cart_contents['data'][] = ['id' => $row->id, 'id_nomenclature' => $row->id_nomenclature, 'id_nomenclature_type' => $row->id_nomenclature_type, 'nomenclature_name' => $row->nomenclature_name, 'unit' => $row->unit, 'price' => explode('|', $row->price), 'sum' => (int) $row->sum, 'total' => (float) $row->total, 'quantity' => (int) $row->quantity, 'length' => $row->length];
					
				}
				
			}
			
		} catch (QueryException $e) {
			$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
			if(strpos($err, 'Base table or view not found') === false){
				$this->log_er_mysql($err);
				return ['', '', $err];
			}else{
				return ['', '', 'CART_IS_EMPTY'];
			}
		}
		
		return [$shipping_warehouse_name, $cart_contents, ''];
		
	}
	
	protected function prepare_result_draft_details(string $main_counterparty_id, string $user_myid, string $draft_id, string $token, array $result) : array {
		
		$counterparties_data = $this->get_counterparties($main_counterparty_id);
		
		if(array_key_exists('error', $counterparties_data)){
			return ['', '', $counterparties_data['error']];
		}
		
		$arr_counterparties_id_name = [];
		foreach ($counterparties_data['data'] as $c) {
			if($c['counterparty_id'] != ''){
				$arr_counterparties_id_name[$c['counterparty_id']] = $c['fullname'];
			}else if($c['application_id'] != '' && $c['application_id'] != '-'){
				$arr_counterparties_id_name[$c['application_id']] = $c['fullname'];
			}
		}
			
		$shipment_warehouses_data = $this->get_shipment_warehouses();

		if(array_key_exists('error', $shipment_warehouses_data)){
			return ['', '', $shipment_warehouses_data['error']];
		}
		
		$arr_shipment_warehouses_id_name = [];
		foreach ($shipment_warehouses_data['data'] as $c) {
			$arr_shipment_warehouses_id_name[$c['СкладИД']] = $c['Наименование'];
		}
			
		$prices_product_catalog_data = $this->get_prices_of_the_main_counterparty($main_counterparty_id);

		if(array_key_exists('error', $prices_product_catalog_data)){
			return ['', '', $prices_product_catalog_data['error']];
		}
		
		$arr_prices_product_catalog_id_price = [];
		foreach ($prices_product_catalog_data['data'] as $c) {
			foreach($c['Данные'] as $c2){
				$arr_prices_product_catalog_id_price[$c2['НоменклатураИД']] = $c2['Цена'];
			}
		}		
		
		$product_catalog_data = $this->get_product_catalog();

		if(array_key_exists('error', $product_catalog_data)){
			return ['', '', $product_catalog_data['error']];
		}
		
		$arr_product_catalog_id_data = [];
		foreach ($product_catalog_data['data'] as $c) {
			foreach ($c['Данные'] as $c2) {
				$arr_product_catalog_id_data[$c2['НоменклатураИД']] = [
					'Наименование' => $c2['Наименование'],
					'ЕдиницаИзмеренияНаименования' => $c2['ЕдиницаИзмеренияНаименования'],
					'КоличествоШтукВКомплекте' => $c2['КоличествоШтукВКомплекте'],
					'КоэффициентПересчетаКоличества' => $c2['КоэффициентПересчетаКоличества'],
					'ЗаполнятьХарактеристику' => $c2['ЗаполнятьХарактеристику'],
					'ПродаетсяКомплектами' => $c2['ПродаетсяКомплектами'],
					'Толщина' => str_replace(',', '.', $c2['Толщина']),
					'ЦветИД' => $c2['ЦветИД'],
					'ОстаткиПоМеталлу' => $c2['ОстаткиПоМеталлу'],
					'ОстаткиВШтуках' => $c2['ОстаткиВШтуках']
				];
			}
		}
			
		$leftover_metal_for_products = $this->get_leftover_metal_for_products();
		
		if(array_key_exists('error', $leftover_metal_for_products)){
			return ['', '', $leftover_metal_for_products['error']];
		}
		
		$arr_leftover_metal_for_products_id_quantity = [];
		foreach ($leftover_metal_for_products['data'] as $key2 => $val2) {
			if($key2 == 'Данные'){
				foreach ($val2 as $c) {
					$arr_leftover_metal_for_products_id_quantity[str_replace(',', '.', $c['Толщина']).'-'.$c['ЦветИД']] = $c['Количество'];
				}
			}
		}
			
		$product_balances = $this->get_product_balances();
		
		if(array_key_exists('error', $product_balances)){
			return ['', '', $product_balances['error']];
		}

		$arr_product_balances_id_quantity = [];
		$is_get_data = false;
		foreach ($product_balances['data'] as $c) {
			$id = '';
			foreach ($c as $key => $val) {
				if($key == 'Данные' && $is_get_data){
					$is_get_data = false;
					foreach ($val as $c2) {
						$arr_product_balances_id_quantity[$id.'-'.$c2['НоменклатураИД']] = $c2['Количество'];
					}
					break;
				}
				if($key == 'СкладИД'){
					$id = $val;
					$is_get_data = true;
					continue;
				}
			}
		}
			
		$counterparty_id = '';
		$counterparty_name = '';
		$shipping_warehouse_id = '';
		$ready_date = '';
		$shipping_date = '';
		$shipping_warehouse_name = '';
		$is_cash_payment = false;
		$document_amount = 0;
		$goods = [];
		$goods_non_standard_addition = [];
		$files_non_standard_addition = [];
		$arr3 = [];
		$fio1 = '';
		$manager_fio1 = '';
		$comment = '';
		
		foreach ($result as $row) {
			
			list($fio1, $manager_fio1, $fio2, $manager_fio2) = $this->get_fio_and_manager_fio($row->client_id);
			$comment = $row->comment;
			
			$counterparty_id = $row->counterparty_id;
			$counterparty_name = '';
			if(array_key_exists($counterparty_id, $arr_counterparties_id_name)){
				$counterparty_name = $arr_counterparties_id_name[$counterparty_id];
			}
			
			$ready_date = str_replace('01 янв 0001', 'нет', $this->convert_format_date2($row->shipping_date));
			if($ready_date == ''){$ready_date = 'нет';}
			if($row->is_shipping == '1'){
				$shipping_date = $ready_date;
			}else{
				$shipping_date = 'нет';
			}
			
			$shipping_warehouse_id = $row->shipping_warehouse_id;
			$shipping_warehouse_name = '';
			if(array_key_exists($shipping_warehouse_id, $arr_shipment_warehouses_id_name)){
				$shipping_warehouse_name = $arr_shipment_warehouses_id_name[$shipping_warehouse_id];
			}
			
			$is_cash_payment = ($row->is_cash_payment == '1');
			$arr = [];
			$goods = json_decode($row->goods, true);
			$goods_non_standard_addition = json_decode($row->goods_non_standard_addition, true);
			if($goods_non_standard_addition === null){
				$goods_non_standard_addition = [];
			}
			$files_non_standard_addition = json_decode($row->files_non_standard_addition, true);
			if($files_non_standard_addition === null){
				$files_non_standard_addition = [];
			}
			foreach ($goods as $c) {
				
				$id_nomenclature = $c['НоменклатураИД'];
				$id_nomenclature_type = '';
				
				if(array_key_exists('ВидНоменклатурыИД', $c)){
					$id_nomenclature_type = $c['ВидНоменклатурыИД'];
				}
				
				$arr2 = [
					'НоменклатураИД' => $id_nomenclature,
					'ВидНоменклатурыИД' => $id_nomenclature_type,
					'Характеристика' => $c['Характеристика'],
					'Количество' => $c['Количество'],
					'ПроцентБонуса' => $c['ПроцентБонуса']
				];
				$arr2['КоличествоЛистов'] = -1;
				$arr2['Резерв'] = -1;
				$arr2['Цена'] = -1;
				$arr2['Сумма'] = 0;
				$arr2['ПроцентСкидкиНаценки'] = 0;
				$arr2['НоменклатураНаименование'] = '';
				$arr2['ЕдиницаИзмеренияНаименования'] = '';
				$arr2['Толщина'] = '';
				$arr2['ЦветИД'] = '';
				$arr2['ОстаткиПоМеталлу'] = false;
				$arr2['ОстаткиВШтуках'] = false;
				$arr2['КоличествоШтукВКомплекте'] = 0;
				$arr2['КоэффициентПересчетаКоличества'] = 0;
				$arr2['ЗаполнятьХарактеристику'] = false;
				$arr2['ПродаетсяКомплектами'] = false;
				$arr2['Наличие'] = '-';
				$arr2['Итого'] = -1;
			
				if(array_key_exists($id_nomenclature, $arr_prices_product_catalog_id_price)){
					$arr2['Цена'] = $arr_prices_product_catalog_id_price[$id_nomenclature];
				}
				
				if(array_key_exists($id_nomenclature, $arr_product_catalog_id_data)){
					$arr2['НоменклатураНаименование'] = $arr_product_catalog_id_data[$id_nomenclature]['Наименование'];
					$arr2['ЕдиницаИзмеренияНаименования'] = $arr_product_catalog_id_data[$id_nomenclature]['ЕдиницаИзмеренияНаименования'];
					$arr2['КоличествоШтукВКомплекте'] = $arr_product_catalog_id_data[$id_nomenclature]['КоличествоШтукВКомплекте'];
					$arr2['КоэффициентПересчетаКоличества'] = $arr_product_catalog_id_data[$id_nomenclature]['КоэффициентПересчетаКоличества'];
					$arr2['ЗаполнятьХарактеристику'] = $arr_product_catalog_id_data[$id_nomenclature]['ЗаполнятьХарактеристику'];
					$arr2['ПродаетсяКомплектами'] = $arr_product_catalog_id_data[$id_nomenclature]['ПродаетсяКомплектами'];
					$arr2['Толщина'] = $arr_product_catalog_id_data[$id_nomenclature]['Толщина'];
					$arr2['ЦветИД'] = $arr_product_catalog_id_data[$id_nomenclature]['ЦветИД'];
					$arr2['ОстаткиПоМеталлу'] = $arr_product_catalog_id_data[$id_nomenclature]['ОстаткиПоМеталлу'];
					$arr2['ОстаткиВШтуках'] = $arr_product_catalog_id_data[$id_nomenclature]['ОстаткиВШтуках'];
				}
				
				if($arr2['ОстаткиПоМеталлу'] && $arr2['ОстаткиВШтуках']){
					$arr2['Наличие'] = 'ошибка';
				}
				if(!$arr2['ОстаткиПоМеталлу'] && !$arr2['ОстаткиВШтуках']){
					$arr2['Наличие'] = 'ошибка 2';
				}
				
				if($arr2['Наличие'] == '-'){
					
					if($arr2['ОстаткиПоМеталлу']){
						if(array_key_exists($arr2['Толщина'].'-'.$arr2['ЦветИД'], $arr_leftover_metal_for_products_id_quantity)){
							$arr2['Наличие'] = $arr_leftover_metal_for_products_id_quantity[$arr2['Толщина'].'-'.$arr2['ЦветИД']];
						}
					}
					
					if($arr2['ОстаткиВШтуках']){
						if(array_key_exists($shipping_warehouse_id.'-'.$id_nomenclature, $arr_product_balances_id_quantity)){
							$arr2['Наличие'] = $arr_product_balances_id_quantity[$shipping_warehouse_id.'-'.$id_nomenclature].' шт.';
						}
					}
					
				}
				
				if($arr2['ЗаполнятьХарактеристику']){
					if($c['Характеристика'] == ''){
						$total = $c['Количество'] * 1 * $arr2['КоэффициентПересчетаКоличества'] / 1000;
					}else{
						$total = $c['Количество'] * $c['Характеристика'] * $arr2['КоэффициентПересчетаКоличества'] / 1000;
					}
				}else if($arr2['ПродаетсяКомплектами']){
					$total = $c['Количество'] * $arr2['КоличествоШтукВКомплекте'];
				}else{
					$total = $c['Количество'];
				}
				$arr2['Итого'] = round($total, 3);
				
				if($arr2['Цена'] > -1){
					$arr2['Сумма'] = round($arr2['Итого'] * $arr2['Цена'] * (1 - (($c['ПроцентБонуса'] + $arr2['ПроцентСкидкиНаценки']) / 100)), 2);
				}
				
				$document_amount += $arr2['Сумма'];
				$arr[] = $arr2;	

				$arr3[] = ['НоменклатураИД' => $id_nomenclature, 'Количество' => $arr2['Итого']];
			
			}
			
			$goods = $arr;
			$arr = [];
			
			foreach($goods_non_standard_addition as $c){
				$arr[] = [
					'Описание' => $c['Описание'],
					'Количество' => $c['Количество']
				];	
			}
			
			$goods_non_standard_addition = $arr;
			$arr = [];
			
			foreach($files_non_standard_addition as $c){
				$arr[] = [
					'СсылкаНаФайл' => $c['СсылкаНаФайл'],
					'ИмяФайла' => $c['ИмяФайла']
				];	
			}
			
			$files_non_standard_addition = $arr;
			$arr = [];

		}
		
		list($result, $err) = $this->post_request_to_api_1c('weight_calculation', ['data' => $arr3, 'token' => $token]);
		if($err){
			return ['', '', $err];
		}

		if(array_key_exists('Ошибка', $result)){
			return ['', '', $result['Ошибка']];
		}

		if(!array_key_exists('Вес', $result)){
			return ['', '', 'NO_EXISTS_KEY_Вес'];
		}
		
		$weight = $result['Вес'];
		
		$draft_details = [
			'КонтрагентИД' => $counterparty_id,
			'КонтрагентНаименование' => $counterparty_name,
			'СкладОтгрузкиИД' => $shipping_warehouse_id,
			'СкладОтгрузкиНаименование' => $shipping_warehouse_name,
			'ДатаГотовности' => $ready_date,
			'ДатаДоставки' => $shipping_date,
			'НаличнаяОплата' => $is_cash_payment,
			'СуммаДокумента' => round($document_amount, 2),
			'Вес' => round($weight, 2),
			'Запасы' => $goods,
			'НестандартнаяДоборка' => $goods_non_standard_addition,
			'НестандартнаяДоборкаПрикрепленныеФайлы' => $files_non_standard_addition,
			'ОтветственныйОтКлиента' => $fio1,
			'ОтветственныйSokrof' => $manager_fio1,
			'Комментарий' => $comment 			
		];
		
		$commercial_offers = [];
		$result = [];
		
		try{
			$result = DB::select('SELECT `commercial_offer_amount`, `markup_type`, `markup_percentage`, CONVERT(AES_DECRYPT(`recipient_of_the_commercial_offer`, :aes_key) USING utf8mb4) AS `recipient_of_the_commercial_offer`, `commercial_offer_id` FROM `commercial_offers_'.$user_myid.'` WHERE `draft_id` = :draft_id ORDER BY `id` DESC', ['aes_key' => $this->aes_key[0], 'draft_id' => $draft_id]);
		} catch (QueryException $e) {
			$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
			if(strpos($err, 'Base table or view not found') === false){
				$this->log_er_mysql($err);
				return ['', '', $err];
			}
		}
		
		foreach ($result as $row) {
			$commercial_offers[] = ['commercial_offer_id' => $row->commercial_offer_id, 'client' => $row->recipient_of_the_commercial_offer, 'extra_charge' => ($row->markup_type == 'manual' ? 'Ручная' : $row->markup_percentage.'% ко всем ценам'), 'cp_amount' => ((float) $row->commercial_offer_amount)];
		}
		
		return [$draft_details, $commercial_offers, ''];
		
	}
	
	protected function get_data_from_popular_statuses(string $main_counterparty_id) : string {
		
		$result = DB::select('SELECT `status` FROM `orders_'.$main_counterparty_id.'` WHERE `id` > 1');
		
		$ready_for_shipment = 0;
		$with_shipments = 0;
		$needs_confirmation = 0;
		$draft = 0;
		
		foreach ($result as $row) {
			switch($row->status){
				case 'ready_for_shipment':
					$ready_for_shipment++;
					break;
				case 'in_shipment':
					$with_shipments++;
					break;
				case 'needs_confirmation':
					$needs_confirmation++;
					break;
				case 'draft':
					$draft++;
					break;
			}
		}
		
		return json_encode(['ready_for_shipment' => $ready_for_shipment, 'with_shipments' => $with_shipments, 'needs_confirmation' => $needs_confirmation, 'draft' => $draft]);
				
	}
	
	protected function get_employees2(string $main_counterparty_id) : array {
		
		$employees_data = ['data' => []];
		
		try{
			
			$result = DB::select('SELECT `user_myid`, CONVERT(AES_DECRYPT(`fio`, :aes_key) USING utf8mb4) AS `fio`, `is_banned` FROM `users` WHERE `main_counterparty_id` = :main_counterparty_id', ['aes_key' => $this->aes_key[0], 'main_counterparty_id' => $main_counterparty_id]);
			
			foreach ($result as $row) {
				if($row->is_banned == ''){
					
					preg_match('/([^ ]+) ([^ ]+) ([^ ]+)/', $row->fio, $matches);
					if($matches){
						$fio2 = mb_strtoupper(mb_substr($matches[2], 0, 1)) . '. ' . mb_strtoupper(mb_substr($matches[1], 0, 1)) . mb_strtolower(mb_substr($matches[1], 1, 255));
					}else{
						$fio2 = '';
					}
					
					$employees_data['data'][] = ['user_myid' => $row->user_myid, 'fio2' => $fio2];
				}
			}
			
		} catch (QueryException $e) {
			$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
			$this->log_er_mysql($err);
			return ['error' => $err];
		}
		
		return $employees_data;
		
	}
	
	protected function get_fio_and_manager_fio(string $client_id) : array {
		
		$fio1 = '';
		$manager_fio1 = '';
		$fio2 = '';
		$manager_fio2 = '';
		
		try{
			
			$result = DB::select('SELECT CONVERT(AES_DECRYPT(`fio`, :aes_key) USING utf8mb4) AS `fio`, CONVERT(AES_DECRYPT(`manager_fio`, :aes_key2) USING utf8mb4) AS `manager_fio` FROM `users` WHERE `user_myid` = :user_myid LIMIT 1', ['aes_key' => $this->aes_key[0], 'aes_key2' => $this->aes_key[0], 'user_myid' => $client_id]);
			
			foreach ($result as $row) {
				
				preg_match('/([^ ]+) ([^ ]+) ([^ ]+)/', $row->fio, $matches);
				if($matches){
					$fio1 = $matches[2].' '.$matches[1];
				}

				preg_match('/([^ ]+) ([^ ]+) ([^ ]+)/', $row->fio, $matches);
				if($matches){
					$fio2 = mb_strtoupper(mb_substr($matches[2], 0, 1)) . '. ' . mb_strtoupper(mb_substr($matches[1], 0, 1)) . mb_strtolower(mb_substr($matches[1], 1, 255));
				}
					
				preg_match('/([^ ]+) ([^ ]+) ([^ ]+)/', $row->manager_fio, $matches);
				if($matches){
					$manager_fio1 = $matches[2].' '.$matches[1];
				}
				
				preg_match('/([^ ]+) ([^ ]+) ([^ ]+)/', $row->manager_fio, $matches);
				if($matches){
					$manager_fio2 = mb_strtoupper(mb_substr($matches[2], 0, 1)) . '. ' . mb_strtoupper(mb_substr($matches[1], 0, 1)) . mb_strtolower(mb_substr($matches[1], 1, 255));
				}
				
			}
			
		} catch (QueryException $e) {
			$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
			$this->log_er_mysql($err);
			return ['', '', '', '', $err];
		}
		
		return [$fio1, $manager_fio1, $fio2, $manager_fio2, ''];
		
	}
	
	protected function update_data_for_head_counterparty(string $main_counterparty_id, string $token) : array {
		
		if($main_counterparty_id == '00000000-0000-0000-0000-000000000000' || $main_counterparty_id == ''){
			return array('', 'THE_MAIN_COUNTERPARTY_IS_NOT_CORRECT');
		}
		
		list($result, $err) = $this->post_request_to_api_1c('get_counterparties', ['token' => $token]);
		if($err){
			return array('', $this->escape_unicode_decode($err));
		}
		
		if(array_key_exists('Ошибка', $result)){
			return array('', $this->escape_unicode_decode($result['Ошибка']));
		}
		
		if(!is_array($result)){
			return array('', 'RESULT_IS_NOT_ARRAY');
		}
		
		$counterparty_id = '';
		$application_id = '';
		$fullname = '';
		$inn = '';
		$kpp = '';
		$ogrn = '';
		$legal_address = '';
		$actual_address = '';
		$corr_account = '';
		$bank_bik = '';
		$bank_name = '';
		$checking_account = '';
		$id_delivery_addresses = '';
		$bonus_percentage = '';
		$under_consideration = false;
		$arr = [];
		$arr2 = [];
		
		foreach($result as $c){
			
			if(!array_key_exists('ГоловнойКонтрагентИД', $c)){
				return array('', 'NO_EXISTS_KEY_ГоловнойКонтрагентИД');
			}
			if(!array_key_exists('КонтрагентИД', $c)){
				return array('', 'NO_EXISTS_KEY_КонтрагентИД');
			}
			if(!array_key_exists('НаименованиеПолное', $c)){
				return array('', 'NO_EXISTS_KEY_НаименованиеПолное');
			}
			if(!array_key_exists('ИНН', $c)){
				return array('', 'NO_EXISTS_KEY_ИНН');
			}
			if(!array_key_exists('КПП', $c)){
				return array('', 'NO_EXISTS_KEY_КПП');
			}
			if(!array_key_exists('ОГРН', $c)){
				return array('', 'NO_EXISTS_KEY_ОГРН');
			}
			if(!array_key_exists('ЮрАдресКонтрагента', $c)){
				return array('', 'NO_EXISTS_KEY_ЮрАдресКонтрагента');
			}
			if(!array_key_exists('ФактАдресКонтрагента', $c)){
				return array('', 'NO_EXISTS_KEY_ФактАдресКонтрагента');
			}
			if(!array_key_exists('КоррСчет', $c)){
				return array('', 'NO_EXISTS_KEY_КоррСчет');
			}
			if(!array_key_exists('БикБанка', $c)){
				return array('', 'NO_EXISTS_KEY_БикБанка');
			}
			if(!array_key_exists('НаименованиеБанка', $c)){
				return array('', 'NO_EXISTS_KEY_НаименованиеБанка');
			}
			if(!array_key_exists('РасчетныйСчет', $c)){
				return array('', 'NO_EXISTS_KEY_РасчетныйСчет');
			}
			if(!array_key_exists('ОсновнойАдресДоставкиИД', $c)){
				return array('', 'NO_EXISTS_KEY_ОсновнойАдресДоставкиИД');
			}
			if(!array_key_exists('ПроцентБонуса', $c)){
				return array('', 'NO_EXISTS_KEY_ПроцентБонуса');
			}
			if(!array_key_exists('НаРассмотрении', $c)){
				return array('', 'NO_EXISTS_KEY_НаРассмотрении');
			}
			
			$main_counterparty_id = mb_substr(htmlspecialchars($c['ГоловнойКонтрагентИД'], ENT_QUOTES, $this->encoding), 0, 36);
			$counterparty_id = mb_substr(htmlspecialchars($c['КонтрагентИД'], ENT_QUOTES, $this->encoding), 0, 36);
			$application_id = '-';
			$fullname = mb_substr(htmlspecialchars($c['НаименованиеПолное'], ENT_QUOTES, $this->encoding), 0, 255);
			$inn = mb_substr(htmlspecialchars($c['ИНН'], ENT_QUOTES, $this->encoding), 0, 12);
			$kpp = mb_substr(htmlspecialchars($c['КПП'], ENT_QUOTES, $this->encoding), 0, 9);
			$ogrn = mb_substr(htmlspecialchars($c['ОГРН'], ENT_QUOTES, $this->encoding), 0, 13);
			$legal_address = mb_substr(htmlspecialchars($c['ЮрАдресКонтрагента'], ENT_QUOTES, $this->encoding), 0, 500);
			$actual_address = mb_substr(htmlspecialchars($c['ФактАдресКонтрагента'], ENT_QUOTES, $this->encoding), 0, 500);
			$corr_account = mb_substr(htmlspecialchars($c['КоррСчет'], ENT_QUOTES, $this->encoding), 0, 20);
			$bank_bik = mb_substr(htmlspecialchars($c['БикБанка'], ENT_QUOTES, $this->encoding), 0, 9);
			$bank_name = mb_substr(htmlspecialchars($c['НаименованиеБанка'], ENT_QUOTES, $this->encoding), 0, 100); 
			$checking_account = mb_substr(htmlspecialchars($c['РасчетныйСчет'], ENT_QUOTES, $this->encoding), 0, 20);
			$id_delivery_addresses = mb_substr(htmlspecialchars($c['ОсновнойАдресДоставкиИД'], ENT_QUOTES, $this->encoding), 0, 36);
			$bonus_percentage = mb_substr(htmlspecialchars($c['ПроцентБонуса'], ENT_QUOTES, $this->encoding), 0, 3);
			$under_consideration = htmlspecialchars($c['НаРассмотрении'], ENT_QUOTES, $this->encoding);
			
			if($under_consideration){
				$application_id = $counterparty_id;
				$counterparty_id = '';
			}
			
			$arr1 = ['counterparty_id' => $counterparty_id, 'application_id' => $application_id, 'fullname' => $fullname, 'inn' => $inn, 'kpp' => $kpp, 'ogrn' => $ogrn, 'legal_address' => $legal_address, 'actual_address' => $actual_address, 'corr_account' => $corr_account, 'bank_bik' => $bank_bik, 'bank_name' => $bank_name, 'checking_account' => $checking_account, 'id_delivery_addresses' => $id_delivery_addresses, 'bonus_percentage' => $bonus_percentage, 'is_confirmed' => (!$under_consideration ? '1' : '')];
			
			if($c['КонтрагентИД'] == $main_counterparty_id){
				$arr = $arr1;
			}else{
				$arr2[] = $arr1;
			}
			
		}
			
		if(sizeof($arr) == 0){
			return array('', 'NO_EXISTS_HEAD_COUNTERPARTY_ID');
		}
		
		$mysqli = @new \mysqli(env('DB_HOST'), env('DB_USERNAME'), env('DB_PASSWORD'), env('DB_DATABASE'));		
		if($mysqli->connect_error) {
			$err = $mysqli->connect_error;
			$this->log_er_mysql($err);
			return array('', $err);
		}
		
		if(!$mysqli->query('CREATE TABLE `counterparties_'.$main_counterparty_id.'` (`id` int UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY, `counterparty_id` char(36) NOT NULL DEFAULT \'\', `application_id` char(36) NOT NULL DEFAULT \'\', `fullname` blob DEFAULT NULL, `inn` tinyblob DEFAULT NULL, `kpp` tinyblob DEFAULT NULL, `ogrn` tinyblob DEFAULT NULL, `legal_address` blob DEFAULT NULL, `actual_address` blob DEFAULT NULL, `corr_account` tinyblob DEFAULT NULL, `bank_bik` tinyblob DEFAULT NULL, `bank_name` tinyblob DEFAULT NULL, `checking_account` tinyblob DEFAULT NULL, `bonus_percentage` tinyint(3) UNSIGNED DEFAULT 0, `id_delivery_addresses` char(36) DEFAULT \'\', `is_confirmed` char(1) DEFAULT \'\', `ids_row_update` text NOT NULL DEFAULT \'\') ENGINE=InnoDB DEFAULT CHARSET=utf8mb4')){
			$err = $mysqli->error;
			if(strpos($err, 'already exists') === false){
				$this->log_er_mysql($err);
				return array('', $err);
			}else{
				array_unshift($arr2, $arr);
				return array($arr2, '');
			}
		}
		
		try{
		
			DB::beginTransaction();
			
				if(DB::table('counterparties_'.$main_counterparty_id)->count('id') == 0){
				
					DB::insert('INSERT INTO `counterparties_'.$main_counterparty_id.'` (`ids_row_update`) values (\'\')');
					
					foreach([$arr] as $c){
						DB::insert('INSERT INTO `counterparties_'.$main_counterparty_id.'` (`counterparty_id`, `application_id`, `fullname`, `inn`, `kpp`, `ogrn`, `legal_address`, `actual_address`, `corr_account`, `bank_bik`, `bank_name`, `checking_account`, `bonus_percentage`, `id_delivery_addresses`, `is_confirmed`) values (:counterparty_id, :application_id, AES_ENCRYPT(:fullname, :aes_key), AES_ENCRYPT(:inn, :aes_key2), AES_ENCRYPT(:kpp, :aes_key3), AES_ENCRYPT(:ogrn, :aes_key4), AES_ENCRYPT(:legal_address, :aes_key5), AES_ENCRYPT(:actual_address, :aes_key6), AES_ENCRYPT(:corr_account, :aes_key7), AES_ENCRYPT(:bank_bik, :aes_key8), AES_ENCRYPT(:bank_name, :aes_key9), AES_ENCRYPT(:checking_account, :aes_key10), :bonus_percentage, :id_delivery_addresses, :is_confirmed)', ['counterparty_id' => $c['counterparty_id'], 'application_id' => $c['application_id'], 'fullname' => $c['fullname'], 'aes_key' => $this->aes_key[0], 'inn' => $c['inn'], 'aes_key2' => $this->aes_key[0], 'kpp' => $c['kpp'], 'aes_key3' => $this->aes_key[0], 'ogrn' => $c['ogrn'], 'aes_key4' => $this->aes_key[0], 'legal_address' => $c['legal_address'], 'aes_key5' => $this->aes_key[0], 'actual_address' => $c['actual_address'], 'aes_key6' => $this->aes_key[0], 'corr_account' => $c['corr_account'], 'aes_key7' => $this->aes_key[0], 'bank_bik' => $c['bank_bik'], 'aes_key8' => $this->aes_key[0], 'bank_name' => $c['bank_name'], 'aes_key9' => $this->aes_key[0], 'checking_account' => $c['checking_account'], 'aes_key10' => $this->aes_key[0], 'bonus_percentage' => $c['bonus_percentage'], 'id_delivery_addresses' => $c['id_delivery_addresses'], 'is_confirmed' => $c['is_confirmed']]);
					}

					foreach($arr2 as $c){
						DB::insert('INSERT INTO `counterparties_'.$main_counterparty_id.'` (`counterparty_id`, `application_id`, `fullname`, `inn`, `kpp`, `ogrn`, `legal_address`, `actual_address`, `corr_account`, `bank_bik`, `bank_name`, `checking_account`, `bonus_percentage`, `id_delivery_addresses`, `is_confirmed`) values (:counterparty_id, :application_id, AES_ENCRYPT(:fullname, :aes_key), AES_ENCRYPT(:inn, :aes_key2), AES_ENCRYPT(:kpp, :aes_key3), AES_ENCRYPT(:ogrn, :aes_key4), AES_ENCRYPT(:legal_address, :aes_key5), AES_ENCRYPT(:actual_address, :aes_key6), AES_ENCRYPT(:corr_account, :aes_key7), AES_ENCRYPT(:bank_bik, :aes_key8), AES_ENCRYPT(:bank_name, :aes_key9), AES_ENCRYPT(:checking_account, :aes_key10), :bonus_percentage, :id_delivery_addresses, :is_confirmed)', ['counterparty_id' => $c['counterparty_id'], 'application_id' => $c['application_id'], 'fullname' => $c['fullname'], 'aes_key' => $this->aes_key[0], 'inn' => $c['inn'], 'aes_key2' => $this->aes_key[0], 'kpp' => $c['kpp'], 'aes_key3' => $this->aes_key[0], 'ogrn' => $c['ogrn'], 'aes_key4' => $this->aes_key[0], 'legal_address' => $c['legal_address'], 'aes_key5' => $this->aes_key[0], 'actual_address' => $c['actual_address'], 'aes_key6' => $this->aes_key[0], 'corr_account' => $c['corr_account'], 'aes_key7' => $this->aes_key[0], 'bank_bik' => $c['bank_bik'], 'aes_key8' => $this->aes_key[0], 'bank_name' => $c['bank_name'], 'aes_key9' => $this->aes_key[0], 'checking_account' => $c['checking_account'], 'aes_key10' => $this->aes_key[0], 'bonus_percentage' => $c['bonus_percentage'], 'id_delivery_addresses' => $c['id_delivery_addresses'], 'is_confirmed' => $c['is_confirmed']]);
					}
				
				}
			
			DB::commit();
		
		} catch (QueryException $e) {
			
			DB::rollBack();
			$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
			$this->log_er_mysql($err);
			return array('', $err);
			
		}
		
		array_unshift($arr2, $arr);
		
		return array($arr2, '');
		
	}

	protected function check_goods(array $goods) : array {
	
		$new_goods = [];

		foreach ($goods as $good) {
				if (!empty($good['НоменклатураИД']) && !empty($good['ВидНоменклатурыИД']) && !empty($good['Количество']) && is_numeric($good['Количество']) && array_key_exists('ПроцентБонуса', $good) && is_numeric($good['ПроцентБонуса'])) {
						$new_goods[] = $good;
				} else {
						return [null, 'В поле Товары указана структура товаров с ошибками'];
				}
		}

		return [$new_goods, null];
			
	}

  protected function check_non_standard_goods($goods) : array {
		
		$new_goods = [];

		foreach ($goods as $good) {
				if (!empty($good['Описание']) && !empty($good['Количество']) && is_int($good['Количество'])) {
						$new_goods[] = $good;
				} else {
						return [null, 'В поле НестандартнаяДоборка указана структура товаров с ошибками'];
				}
		}
		return [$new_goods, null];
				
  }
		
	protected function upload_file_from_base64(string $user_id, string $file_name, string $base64_data) : string {
		
		$file_data = base64_decode($base64_data);

		if (!is_dir($this->document_root . '/user_files/' . $user_id)) {
				mkdir($this->document_root . '/user_files/' . $user_id, 0774);
		}

		if (!is_dir($this->document_root . '/user_files/' . $user_id . '/files_for_non_standard_addition')) {
				mkdir($this->document_root . '/user_files/' . $user_id . '/files_for_non_standard_addition', 0774);
		}
		
		file_put_contents($this->document_root . '/user_files/' . $user_id . '/files_for_non_standard_addition/' . $file_name, $file_data);
		$file = '/user_files/' . $user_id . '/files_for_non_standard_addition/' . $file_name;
		
		if(file_exists($this->document_root . $file)){
			chmod($this->document_root . $file, 0664);
		}
		
		return $file;
				
	}
	
	protected function validate_fields(string $target, Request $request) : string {
		
		switch($target){
			
			case 'other':
				if(empty($request->input('data_crypt'))){
					return 'DATA_CRYPT_IS_INCORRECT';
				}
				
				if(empty($request->input('symmetric_key_crypt'))){
					return 'SYMMETRIC_KEY_CRYPT_IS_INCORRECT';
				}

				if(empty($request->input('client_rsa_pubkey'))){
					return 'CLIENT_RSA_PUBKEY_IS_INCORRECT';
				}
				break;
		
		}
	
		return '';
		
	}
	
	protected function validate_get_params(string $target) : string {
		
		switch($target){
			
			case 'other':
				if(empty($_GET['client_rsa_pubkey'])){
					return 'CLIENT_RSA_PUBKEY_IS_INCORRECT';
				}
				break;
				
		}
		
		return '';
		
	}
	
	protected function get_common_rsa_keys() : array {
		
		try{
			
			$rsa_pubkey = '';
			$rsa_privkey = '';
			
			$result = DB::select('SELECT SQL_CACHE CONVERT(AES_DECRYPT(`rsa_pubkey`, :aes_key) USING utf8mb4) AS `rsa_pubkey`, CONVERT(AES_DECRYPT(`rsa_privkey`, :aes_key2) USING utf8mb4) AS `rsa_privkey` FROM `common_rsa_keys` WHERE `id` = 1 LIMIT 1', ['aes_key' => $this->aes_key[0], 'aes_key2' => $this->aes_key[0]]);			
			
			if(sizeof($result) == 0){
				return [null, null, 'NOT_FOUND_RSA_PRIVKEY'];
			}
						
			foreach ($result as $row) {
				$rsa_pubkey = $row->rsa_pubkey;
				$rsa_privkey = $row->rsa_privkey;
			}

		} catch (QueryException $e) {
			$err = mb_convert_encoding($e->getMessage(), 'ASCII', 'UTF-8');
			$this->log_er_mysql($err);
			return [null, null, $err];
		}
		
		return [$rsa_pubkey, $rsa_privkey, null];
		
	}
	
	protected function decrypt_symmetric_key(string $symmetric_key_crypt) : array {
		
		$rsa_privkey = '';
		
		list($rsa_pubkey, $rsa_privkey, $err) = $this->get_common_rsa_keys();
		if($err){
			return [null, $err];
		}
		
		list($result, $err) = $this->rsa_crypto_service('decrypt', $symmetric_key_crypt, $rsa_privkey, '');
		if($err){
			return [null, $err];
		}
		
		return [trim($result), null];
		
	}

	private function log_er_aes_crypto_service(string $mess) : void {

		$f = @fopen($this->document_root.'/../storage/logs/errors_aes_crypto_service(php).log', 'a+');
		$text =	date('D M j G:i:s T Y').' '.$this->time . ' ' .trim($mess) . PHP_EOL . '----------------------------------------------------------------------------------------'. PHP_EOL;
		@stream_set_write_buffer($f, 0);
		@fwrite($f, $text);
		@fflush($f);
		@fclose($f);
		
	}
	
	protected function aes_crypto_service(string $act, string $data, string $key) : array {

		$result = '';
		$err = '';
		$payload = json_encode(['act' => $act, 'data' => $data, 'key' => $key]);
		
		for($i = 0; $i < 3; $i++){
					
			$start_time = time();
			
			if(PHP_OS != 'WINNT'){
				$full_url = 'unix://'.$this->config_project['aes_crypto_service_socket'];
				$socket = @fsockopen($full_url, -1, $errorNumber, $errorDescription, $this->config_project['connect_process_timeout2']);
			}else{
				$full_url = 'http://127.0.0.1:'.$this->config_project['aes_crypto_service_port'];
				$socket = @fsockopen('127.0.0.1', $this->config_project['aes_crypto_service_port'], $errorNumber, $errorDescription, $this->config_project['connect_process_timeout2']);
			}
			
			if(!$socket ){
				$err = 'FAIL_SOCKET_CONNECT ('.$full_url.')';
				$this->log_er_aes_crypto_service($err);
				continue;
			}
						
			fwrite($socket, $payload . "\n");
			
			while (true) {
				$data = fgets($socket, 1024);
				if(mb_strlen($data) == 0){
					break;
				}
				$result .= $data;
				if(preg_match('/(\r|\n|\r\n)$/', $data)){
					break;
				}
			}
			fclose($socket);
			
			$end_time = time();
			$result = urldecode($result);
			
			preg_match('/^\{"(result|error)":/', $result, $matches);
			
			if($matches){
				
				if($matches[1] == 'error'){
					$err = json_decode($result, true)['error'];
					$result = '';
				}else{
					$result = preg_replace('/^\{"result": *"|"\}\r\n$/', '', $result);
					$err = '';
				}
				
			}else{
				
				$err = substr(htmlspecialchars($result, ENT_QUOTES, $this->encoding), 0, 255);
				$err = preg_replace('/\r?\n/', '', $err);
				
				if($err == ''){
					if($end_time - $start_time >= $this->config_project['connect_process_timeout2']){
						$err = 'CONNECTION_TIMEOUT ('.$full_url.')';
					}else{
						$err = 'RESULT_IS_EMPTY ('.$full_url.')';
					}
					$this->log_er_aes_crypto_service($err);
					continue;
				}
				$this->log_er_aes_crypto_service($err);
						
			}
			
			if($err != ''){
				return ['', trim($err)];
			}
			
			return [trim($result), null];
		
		}
		return ['', trim($err)];
		
	}

	private function log_er_rsa_crypto_service(string $mess) : void {

		$date = $this->convert_format_date($this->date);
		$f = @fopen($this->document_root.'/../storage/logs/errors_rsa_crypto_service(php).log', 'a+');
		$text =	date('D M j G:i:s T Y').' '.$this->time . ' '. trim($mess) .	PHP_EOL . '----------------------------------------------------------------------------------------'. PHP_EOL;
		@stream_set_write_buffer($f, 0);
		@fwrite($f, $text);
		@fflush($f);
		@fclose($f);
		
	}
	
	protected function rsa_crypto_service(string $act, string $data, string $key = '', string $key_source = '') : array {

		$result = '';
		$err = '';
		if($act == 'decrypt'){
			$key = "-----BEGIN RSA PRIVATE KEY-----\n".$key."\n-----END RSA PRIVATE KEY-----";
		}
		if($act == 'encrypt'){
			$key = "-----BEGIN RSA PUBLIC KEY-----\n".$key."\n-----END RSA PUBLIC KEY-----";
		}
		$payload = json_encode(['act' => $act, 'data' => $data, 'key' => $key, 'key_source' => $key_source]);
		
		for($i = 0; $i < 3; $i++){
					
			$start_time = time();
			
			if(PHP_OS != 'WINNT'){
				$full_url = 'unix://'.$this->config_project['rsa_crypto_service_socket'];
				$socket = @fsockopen($full_url, -1, $errorNumber, $errorDescription, $this->config_project['connect_process_timeout2']);
			}else{
				$full_url = 'http://127.0.0.1:'.$this->config_project['rsa_crypto_service_port'];
				$socket = @fsockopen('127.0.0.1', $this->config_project['rsa_crypto_service_port'], $errorNumber, $errorDescription, $this->config_project['connect_process_timeout2']);
			}
			
			if(!$socket ){
				$err = 'FAIL_SOCKET_CONNECT ('.$full_url.')';
				$this->log_er_rsa_crypto_service($err);
				continue;
			}
			
			fwrite($socket, $payload . "\n");
			while (true) {
				$data = fgets($socket, 1024);
				if(mb_strlen($data) == 0){
					break;
				}
				$result .= $data;
				if(preg_match('/(\r|\n|\r\n)$/', $data)){
					break;
				}
			}
			fclose($socket);
			
			$end_time = time();

			preg_match('/^\{"(result|error)":/', $result, $matches);
			
			if($matches){
				
				if($matches[1] == 'error'){
					$err = json_decode($result, true)['error'];
					$result = '';
				}else{
					$result = json_decode($result, true)['result'];
					$err = '';
				}
			
			}else{
				
				$err = substr(htmlspecialchars($result, ENT_QUOTES, $this->encoding), 0, 255);
				$err = preg_replace('/\r?\n/', '', $err);
				
				if($err == ''){
					if($end_time - $start_time >= $this->config_project['connect_process_timeout2']){
						$err = 'CONNECTION_TIMEOUT ('.$full_url.')';
					}else{
						$err = 'RESULT_IS_EMPTY ('.$full_url.')';
					}
					$this->log_er_rsa_crypto_service($err);
					continue;
				}
				$this->log_er_rsa_crypto_service($err);
						
			}
			
			if($err != ''){
				return ['', trim($err)];
			}
			
			return [trim($result), null];
		
		}
		return ['', trim($err)];
		
	}

	protected function handler_data_crypt(Request $request) : array {
		
		$data_crypt = $request->input('data_crypt');
		$symmetric_key_crypt = $request->input('symmetric_key_crypt');
		$client_rsa_pubkey = $request->input('client_rsa_pubkey');

		$data_crypt = htmlspecialchars($data_crypt, ENT_QUOTES, $this->encoding);
		$symmetric_key_crypt = htmlspecialchars($symmetric_key_crypt, ENT_QUOTES, $this->encoding);
		$client_rsa_pubkey = htmlspecialchars($client_rsa_pubkey, ENT_QUOTES, $this->encoding);

		list($symmetric_key, $err) = $this->decrypt_symmetric_key($symmetric_key_crypt);
		if($err){
			return [null, $err];
		}
		
		list($result, $err) = $this->aes_crypto_service('decrypt', $data_crypt, $symmetric_key);
		if($err){
			return [null, $err];
		}
		
		$data = json_decode(trim($result), true);
		$data['client_rsa_pubkey'] = $client_rsa_pubkey;
	
		return [$data, null];
		
	}
	
	protected function handler_data_crypt2(array $data, string $client_rsa_pubkey) : array {
		
		$symmetric_key = hash('sha256', $this->rnd . $this->time . $this->rnd);
		
		list($data_crypt, $err) = $this->aes_crypto_service('encrypt', str_replace('+', ' ', urlencode(utf8_encode(json_encode($data)))), $symmetric_key);
		if($err){
			return [null, null, $err];
		}

		list($symmetric_key_crypt, $err) = $this->rsa_crypto_service('encrypt', $symmetric_key, $client_rsa_pubkey, 'js');
		if($err){
			return [null, null, $err];
		}
		
		return [$data_crypt, $symmetric_key_crypt, null];
		
	}
		
}
