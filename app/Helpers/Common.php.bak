							}
							
							break;
							
						case 'add_new_delivery_addresses':
						
							if(strpos($result, '"АдресДоставкиИД":') !== false || strpos($result, '"Ошибка":') !== false){
								$json = json_decode($result, true);
							}
							
							break;

						case 'edit_delivery_addresses':
						
							if(strpos($result, '"Сообщение":') !== false || strpos($result, '"Ошибка":') !== false){
								$json = json_decode($result, true);
							}
							
							break;

						case 'delete_delivery_addresses':
						
