				break;
				
		}
		
		$full_url = ($port == 443 ? 'https://' : 'http://').$url.($port != 443 && $port != 80 ? ':'.$port : '').$path;
		
		$cl = curl_init();
		if($cl){
			
			for($i = 0; $i < 3; $i++){
					
