						foreach ($result as $row) {
							$new_notifications[] = ['id' => $row->id, 'date' => $row->date, 'counterparty_id' => $row->counterparty_id, 'document_id' => $row->document_id, 'category' => $row->category, 'subject' => $row->subject, 'message' => $row->message, 'is_unread' => $row->is_unread];
